---
interface Props {
  current?: "home" | "privacy";
}

const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base;
const privacyHref = `${base.replace(/\/$/, "")}/privacy`;
const chromeUrl = "https://chromewebstore.google.com/detail/readto/icijjidbmcgedpiljpknpjomjjijacjp";
---

<header class="sticky top-0 z-50 border-b border-readto-rule bg-readto-bg/88 backdrop-blur-xl supports-[backdrop-filter]:bg-readto-bg/78">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={homeHref} class="group inline-flex min-w-0 items-center gap-3" aria-label="readto 首页">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] border border-readto-rule bg-readto-card font-serif text-[17px] text-readto-fg shadow-[0_1px_0_rgba(20,18,16,0.04)]">r</span>
      <span class="hidden items-baseline gap-1 font-serif text-[20px] font-medium tracking-tight text-readto-fg xs:inline-flex sm:inline-flex">
        readto<span class="text-readto-accent">.</span><span class="text-[0.68em] text-readto-muted transition-colors group-hover:text-readto-fg-2">ai</span>
      </span>
    </a>

    <nav class="hidden items-center rounded-full border border-readto-rule bg-readto-card/70 px-1.5 py-1 text-[13px] text-readto-muted shadow-[0_10px_28px_rgba(20,18,16,0.04)] lg:flex" aria-label="主要导航">
      <a href={homeHref} data-i18n="nav.home" aria-current={current === "home" ? "page" : undefined} class:list={["rounded-full px-3.5 py-1.5 transition hover:text-readto-fg", current === "home" && "bg-readto-fg text-readto-bg hover:text-readto-bg"]}>首页</a>
      <a href={`${homeHref}#experience`} data-i18n="nav.experience" class="rounded-full px-3.5 py-1.5 transition hover:text-readto-fg">体验</a>
      <a href={`${homeHref}#how`} data-i18n="nav.how" class="rounded-full px-3.5 py-1.5 transition hover:text-readto-fg">原理</a>
      <a href={`${homeHref}#fit`} data-i18n="nav.fit" class="rounded-full px-3.5 py-1.5 transition hover:text-readto-fg">适合谁</a>
      <a href={privacyHref} data-i18n="nav.privacy" aria-current={current === "privacy" ? "page" : undefined} class:list={["rounded-full px-3.5 py-1.5 transition hover:text-readto-fg", current === "privacy" && "bg-readto-fg text-readto-bg hover:text-readto-bg"]}>隐私</a>
    </nav>

    <div class="flex items-center gap-2">
      <div class="inline-flex items-center rounded-full border border-readto-rule bg-readto-card p-1 text-[12px] text-readto-muted shadow-[0_1px_0_rgba(20,18,16,0.03)]" aria-label="语言切换">
        <button type="button" data-lang-set="zh" class="site-toggle-pill" aria-pressed="true">中</button>
        <button type="button" data-lang-set="en" class="site-toggle-pill" aria-pressed="false">EN</button>
      </div>
      <button type="button" data-theme-toggle class="site-icon-button" aria-label="切换亮暗主题" aria-pressed="false">
        <span data-theme-icon-light aria-hidden="true">☀</span>
        <span data-theme-icon-dark aria-hidden="true" class="hidden">☾</span>
      </button>
      <a
        href={chromeUrl}
        class="hidden items-center rounded-full border border-readto-fg bg-readto-fg px-4 py-2 text-[13px] font-medium text-readto-bg shadow-[0_10px_24px_rgba(20,18,16,0.08)] transition hover:-translate-y-0.5 hover:border-readto-accent hover:bg-readto-accent sm:inline-flex"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="nav.cta"
      >
        添加到 Chrome
      </a>
    </div>
  </div>

  <div class="border-t border-readto-rule/70 px-4 py-2 sm:px-6 lg:hidden">
    <nav class="mx-auto flex max-w-content items-center justify-between gap-2 overflow-x-auto text-[12px] text-readto-muted" aria-label="移动端导航">
      <a href={homeHref} data-i18n="nav.home" aria-current={current === "home" ? "page" : undefined} class:list={["shrink-0 rounded-full px-3 py-1.5 transition hover:text-readto-fg", current === "home" && "bg-readto-fg text-readto-bg"]}>首页</a>
      <a href={`${homeHref}#experience`} data-i18n="nav.experience" class="shrink-0 rounded-full px-3 py-1.5 transition hover:text-readto-fg">体验</a>
      <a href={`${homeHref}#how`} data-i18n="nav.how" class="shrink-0 rounded-full px-3 py-1.5 transition hover:text-readto-fg">原理</a>
      <a href={privacyHref} data-i18n="nav.privacy" aria-current={current === "privacy" ? "page" : undefined} class:list={["shrink-0 rounded-full px-3 py-1.5 transition hover:text-readto-fg", current === "privacy" && "bg-readto-fg text-readto-bg"]}>隐私</a>
      <a href={chromeUrl} data-i18n="nav.ctaShort" class="shrink-0 rounded-full border border-readto-rule bg-readto-card px-3 py-1.5 text-readto-fg transition hover:border-readto-fg" target="_blank" rel="noopener noreferrer">安装</a>
    </nav>
  </div>
</header>
