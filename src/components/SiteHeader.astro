---
interface Props {
  current?: "home" | "privacy";
}

const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base;
const privacyHref = `${base.replace(/\/$/, "")}/privacy`;
const chromeUrl = "https://chromewebstore.google.com/detail/readto/icijjidbmcgedpiljpknpjomjjijacjp";
---

<header class="border-b border-readto-rule bg-readto-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={homeHref} class="font-serif text-[22px] font-medium tracking-tight text-readto-fg" aria-label="readto 首页">
      readto<span class="text-readto-accent">.</span><span class="text-readto-muted">ai</span>
    </a>

    <div class="flex items-center gap-3 text-[13px] text-readto-muted">
      <nav class="hidden items-center gap-5 sm:flex" aria-label="主要导航">
        <a href={homeHref} data-i18n="nav.home" aria-current={current === "home" ? "page" : undefined} class:list={["transition hover:text-readto-fg", current === "home" && "text-readto-fg"]}>首页</a>
        <a href={privacyHref} data-i18n="nav.privacy" aria-current={current === "privacy" ? "page" : undefined} class:list={["transition hover:text-readto-fg", current === "privacy" && "text-readto-fg"]}>隐私</a>
      </nav>

      <div class="inline-flex items-center rounded-full border border-readto-rule bg-readto-card p-0.5 text-[12px]" aria-label="语言切换">
        <button type="button" data-lang-set="zh" class="site-toggle-pill" aria-pressed="true">中</button>
        <button type="button" data-lang-set="en" class="site-toggle-pill" aria-pressed="false">EN</button>
      </div>

      <button type="button" data-theme-toggle class="site-icon-button" aria-label="切换亮暗主题" aria-pressed="false">
        <span data-theme-icon-light aria-hidden="true">☀</span>
        <span data-theme-icon-dark aria-hidden="true" class="hidden">☾</span>
      </button>

      <a
        href={chromeUrl}
        class="hidden rounded-full border border-readto-rule px-3.5 py-1.5 text-readto-fg transition hover:border-readto-fg md:inline-flex"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="nav.ctaShort"
      >
        安装
      </a>
    </div>
  </div>
</header>
