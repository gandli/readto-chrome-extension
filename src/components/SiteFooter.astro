---
const base = import.meta.env.BASE_URL;
const homeHref = base;
const privacyHref = `${base.replace(/\/$/, "")}/privacy`;
---

<footer class="border-t border-readto-rule">
  <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-4 px-4 py-7 text-[12px] text-readto-muted sm:flex-row sm:px-6">
    <a href={homeHref} class="font-serif text-[15px] text-readto-fg">readto<span class="text-readto-accent">.</span><span class="text-readto-muted">ai</span></a>
    <div class="flex items-center gap-6">
      <a href={privacyHref} class="transition hover:text-readto-fg" data-i18n="footer.privacy">隐私政策</a>
      <span data-i18n="footer.copyright">© 2026 · 读懂</span>
    </div>
  </div>
</footer>
