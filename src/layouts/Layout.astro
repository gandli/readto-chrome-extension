---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'readto · 读懂 — 浏览器里的英文读物，自动标中文释义',
  description = '在任何英文网页上，readto 会根据你的英语水平，悄悄在生词上方标好中文小注。不划词、不跳窗、不中断阅读。',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem('readto-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = storedTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;

          const lang = localStorage.getItem('readto-lang') === 'en' ? 'en' : 'zh';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
        } catch {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body data-base={base}>
    <slot />
    <script is:inline>
      (() => {
        const translations = {
          zh: {
            'nav.home': '首页',
            'nav.privacy': '隐私',
            'nav.ctaShort': '安装',
            'footer.privacy': '隐私政策',
            'footer.copyright': '© 2026 · 读懂',
            'home.badge': 'Chrome 扩展 · 为真实英文网页加中文小注',
            'home.heroTitle': '读英文，<br />不用频繁查词。',
            'home.heroBody': 'readto 会根据你的英语水平，在英文网页的生词上方悄悄标好中文释义。中文小注像书页边注一样出现，不划词、不跳窗、不中断阅读。',
            'home.ctaPrimary': '添加到 Chrome',
            'home.ctaSecondary': '先看一段真实阅读',
            'home.previewHint': '悬停单词',
            'home.how1Title': '先判断你的水平',
            'home.how1Body': '选择入门、基础、进阶、熟练或精通，readto 会把这个水平当作“已掌握词汇”的边界。',
            'home.how2Title': '只给超纲词加注',
            'home.how2Body': '常见词保持原样，真正可能打断理解的词，才在上方出现一条短中文释义。',
            'home.how3Title': '留在原网页阅读',
            'home.how3Body': '新闻、博客、文档、论文都在原页面完成阅读，不跳到另一个学习工具里。',
            'home.fitQuote': '背单词的最好方式，是在真实阅读里反复遇到它。',
            'privacy.badge': '隐私政策 · Last updated 2026-04-24',
            'privacy.heroTitle': '我们不收集你的阅读历史。',
            'privacy.heroBody': 'readto 的标注体验主要发生在你的浏览器本地：根据英语水平给网页里的生词加中文小注。我们不运营阅读历史服务器，不建立账号系统，也不统计你读过哪些页面。',
          },
          en: {
            'nav.home': 'Home',
            'nav.privacy': 'Privacy',
            'nav.ctaShort': 'Install',
            'footer.privacy': 'Privacy Policy',
            'footer.copyright': '© 2026 · readto',
            'home.badge': 'Chrome extension · Chinese glosses on real English pages',
            'home.heroTitle': 'Read English<br />without breaking flow.',
            'home.heroBody': 'readto quietly adds short Chinese glosses above words that are beyond your level. The notes feel like marginalia on the page: no selecting text, no popups first, no interruption.',
            'home.ctaPrimary': 'Add to Chrome',
            'home.ctaSecondary': 'See the reading demo',
            'home.previewHint': 'hover words',
            'home.how1Title': 'Start with your level',
            'home.how1Body': 'Choose beginner, basic, intermediate, advanced, or fluent. readto treats that level as the boundary of words you already know.',
            'home.how2Title': 'Annotate only above-level words',
            'home.how2Body': 'Common words stay untouched. Only the words likely to interrupt comprehension receive a short Chinese gloss.',
            'home.how3Title': 'Stay on the original page',
            'home.how3Body': 'News, blogs, docs, and papers stay where they are. You keep reading instead of jumping into a separate study tool.',
            'home.fitQuote': 'The best way to remember words is to meet them again in real reading.',
            'privacy.badge': 'Privacy Policy · Last updated 2026-04-24',
            'privacy.heroTitle': 'We don’t collect your reading history.',
            'privacy.heroBody': 'readto’s annotation experience mainly happens inside your browser: it adds Chinese glosses to English words based on your level. We do not run a reading-history server, operate an account system, or track which pages you read.',
          },
        };

        const root = document.documentElement;

        function setLang(lang) {
          const next = lang === 'en' ? 'en' : 'zh';
          root.dataset.lang = next;
          root.lang = next === 'en' ? 'en' : 'zh-CN';
          try { localStorage.setItem('readto-lang', next); } catch {}

          document.querySelectorAll('[data-lang-set]').forEach((btn) => {
            const active = btn.getAttribute('data-lang-set') === next;
            btn.setAttribute('aria-pressed', String(active));
            btn.classList.toggle('active', active);
          });

          document.querySelectorAll('[data-i18n]').forEach((node) => {
            const key = node.getAttribute('data-i18n');
            const value = translations[next]?.[key];
            if (value) node.textContent = value;
          });

          document.querySelectorAll('[data-i18n-html]').forEach((node) => {
            const key = node.getAttribute('data-i18n-html');
            const value = translations[next]?.[key];
            if (value) node.innerHTML = value;
          });
        }

        function setTheme(theme) {
          const next = theme === 'dark' ? 'dark' : 'light';
          root.dataset.theme = next;
          root.style.colorScheme = next;
          try { localStorage.setItem('readto-theme', next); } catch {}
          document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-pressed', String(next === 'dark'));
            btn.setAttribute('aria-label', next === 'dark' ? '切换到亮色主题' : '切换到暗黑主题');
          });
          document.querySelectorAll('[data-theme-icon-light]').forEach((el) => el.classList.toggle('hidden', next === 'dark'));
          document.querySelectorAll('[data-theme-icon-dark]').forEach((el) => el.classList.toggle('hidden', next !== 'dark'));
        }

        document.addEventListener('click', (event) => {
          const langBtn = event.target.closest?.('[data-lang-set]');
          if (langBtn) setLang(langBtn.getAttribute('data-lang-set'));

          const themeBtn = event.target.closest?.('[data-theme-toggle]');
          if (themeBtn) setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
        });

        setLang(root.dataset.lang || 'zh');
        setTheme(root.dataset.theme || 'light');
      })();
    </script>
  </body>
</html>
