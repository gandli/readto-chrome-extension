---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- Navigation -->
  <header class="sticky top-0 z-50 bg-[#f5f2eb]/95 backdrop-blur-sm border-b border-[#e3dfd8]">
    <div class="max-w-[1180px] mx-auto flex items-center justify-between gap-6 py-4 px-6">
      <div class="flex items-baseline gap-[18px] min-w-0">
        <a href={base} class="inline-flex items-baseline text-[24px] font-medium font-serif tracking-tight">
          readto<span class="text-[#b2462a] font-semibold">.</span><span class="ml-[2px] text-[0.7em] tracking-normal font-normal text-[#9a9489]">ai</span>
        </a>
        <div class="hidden sm:inline-block text-[12px] text-[#9a9489]">
          读懂每一个词 · Read to know
        </div>
      </div>
      <nav class="flex items-center gap-6">
        <a href="#how" class="text-[14px] text-[#2b2824] hover:text-[#111] transition-colors">
          工作原理
        </a>
        <a href={base} class="text-[14px] text-[#2b2824] hover:text-[#111] transition-colors">
          安装
        </a>
        <a
          href="https://chromewebstore.google.com/detail/readto/hmoifnkckggncdpoplpoiifjafffmkof"
          class="text-[14px] bg-[#111] text-white px-4 py-2 rounded-full hover:opacity-90 transition-opacity"
        >
          安装扩展 →
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="max-w-[1180px] mx-auto px-6 pt-20 pb-24">
      <div class="grid md:grid-cols-[1fr_1.2fr] gap-10 md:gap-14 items-start">
        <!-- Left: Description -->
        <div>
          <p class="text-[11px] text-[#9a9489] tracking-[0.14em] uppercase font-semibold mb-6">
            A CHROME EXTENSION · 浏览器扩展
          </p>
          <h1 class="font-serif font-normal text-[68px] leading-[1.05] tracking-tight m-0 mb-8">
            Read to know.<br/>
            <span class="whitespace-nowrap font-medium">读懂每一个词。</span>
          </h1>
          <p class="text-[15px] text-[#2b2824] leading-[1.7] mb-8 max-w-[400px]">
            在任何英文网页上，readto 会根据你的英语水平，悄悄在生词上方标好中文小注。不划词、不跳窗、不中断阅读。
          </p>
          <a
            href="https://chromewebstore.google.com/detail/readto/hmoifnkckggncdpoplpoiifjafffmkof"
            class="inline-block bg-[#111] text-white px-6 py-3 rounded-full text-[14px] font-medium hover:opacity-90 transition-opacity"
          >
            安装 Chrome 扩展 →
          </a>

          <!-- Level Selector -->
          <div class="mt-14">
            <p class="text-[11px] text-[#9a9489] tracking-[0.14em] uppercase font-semibold mb-4">
              YOUR LEVEL · 你的水平
            </p>
            
            <!-- Slider Labels -->
            <div class="flex justify-between mb-1 px-[10%]">
              <span class="text-[13px] text-[#111] font-medium slider-label active" data-index="0">入门</span>
              <span class="text-[13px] text-[#b8b3ac] slider-label" data-index="1">基础</span>
              <span class="text-[13px] text-[#b8b3ac] slider-label" data-index="2">进阶</span>
              <span class="text-[13px] text-[#b8b3ac] slider-label" data-index="3">熟练</span>
              <span class="text-[13px] text-[#b8b3ac] slider-label" data-index="4">精通</span>
            </div>

            <!-- Custom Slider -->
            <div
              class="relative h-9 mt-2.5 cursor-pointer outline-none"
              role="slider"
              tabindex="0"
              aria-label="英语水平"
              aria-valuemin="1"
              aria-valuemax="5"
              aria-valuenow="3"
              aria-valuetext="进阶"
              id="level-slider"
            >
              <!-- Tick Marks -->
              <div class="absolute left-[10%] right-[10%] top-1/2 h-3.5 -translate-y-1/2 flex justify-between items-center pointer-events-none">
                <div class="w-px h-3.5 bg-[#9a9489]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-3.5 bg-[#9a9489]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-3.5 bg-[#9a9489]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-3.5 bg-[#9a9489]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-2 bg-[#e3dfd8]"></div>
                <div class="w-px h-3.5 bg-[#9a9489]"></div>
              </div>

              <!-- Track -->
              <div class="absolute inset-x-0 top-1/2 h-px bg-[#e3dfd8] -translate-y-1/2"></div>

              <!-- Track Fill -->
              <div class="absolute left-0 top-1/2 h-0.5 bg-[#111] -translate-y-1/2 transition-[width] duration-[350ms] ease-[cubic-bezier(0.2,0.7,0.2,1)]" id="track-fill" style="width:50%"></div>

              <!-- Knob -->
              <div
                class="absolute top-1/2 w-3.5 h-3.5 bg-[#111] rounded-full -translate-x-1/2 -translate-y-1/2 transition-[left,box-shadow] duration-[350ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] cursor-grab shadow-[0_0_0_4px_#f5f2eb,0_0_0_5px_rgba(17,17,17,0.08)] hover:shadow-[0_0_0_4px_#f5f2eb,0_0_0_8px_rgba(17,17,17,0.12)]"
                id="knob"
                style="left:50%"
              ></div>
            </div>

            <p class="text-[13px] text-[#9a9489] mt-3" id="level-desc">
              只标大学四六级以上的词。
            </p>
          </div>
        </div>

        <!-- Right: Browser Mockup -->
        <div class="bg-white rounded-lg shadow-[0_4px_24px_rgba(0,0,0,0.08)] overflow-hidden">
          <div class="bg-[#f5f2eb] px-3 py-2 flex items-center gap-2 border-b border-[#e3dfd8]">
            <span class="w-[10px] h-[10px] rounded-full bg-[#ff5f57]"></span>
            <span class="w-[10px] h-[10px] rounded-full bg-[#febc2e]"></span>
            <span class="w-[10px] h-[10px] rounded-full bg-[#28c840]"></span>
            <span class="flex-1 bg-[#ebe7df] rounded px-3 py-1 text-[12px] text-[#9a9489] ml-2">
              /politics/tax-reform-bill.html
            </span>
          </div>
          <div class="p-6 text-[15px] leading-[1.75] font-sans" id="demo-content">
            <div class="text-[12px] text-[#9a9489] uppercase tracking-[0.14em] font-semibold mb-2">Politics</div>
            <h2 class="font-semibold text-[22px] tracking-tight mb-1 text-[#111]">
              President Announces Sweeping Tax Reforms
            </h2>
            <div class="text-[13px] text-[#9a9489] mb-4">By Anna Reed · April 22, 2026</div>
            <p class="text-[#141210] mb-3">
              The president announced <span data-readto data-word="sweeping">sweeping<span class="rt">大规模的</span></span> reforms to the nation's tax system yesterday, marking the most significant <span data-readto data-word="overhaul">overhaul<span class="rt">大修</span></span> in a decade.
            </p>
            <p class="text-[#141210] mb-3">
              Critics denounce the changes as <span data-readto data-word="disproportionately">disproportionately<span class="rt">不成比例地</span></span> benefiting wealthy citizens, accusing the administration of <span data-readto data-word="profligate">profligate<span class="rt">挥霍的</span></span> giveaways and <span data-readto data-word="austerity">austerity<span class="rt">紧缩</span></span> toward middle-class families already <span data-readto data-word="burdened">burdened<span class="rt">负担</span></span> by rising costs.
            </p>
            <p class="text-[#141210] mb-3">
              Proponents counter that lower taxes will <span data-readto data-word="stimulate">stimulate<span class="rt">刺激</span></span> investment and <span data-readto data-word="ameliorate">ameliorate<span class="rt">改善</span></span> broader <span data-readto data-word="inequities">inequities<span class="rt">不公</span></span>.
            </p>
            <p class="text-[#141210]">
              The bill faces a difficult path through the <span data-readto data-word="fractious">fractious<span class="rt">难驾驭的</span></span>, <span data-readto data-word="polarized">polarized<span class="rt">两极化的</span></span> legislature, where opposition lawmakers have vowed to <span data-readto data-word="obstruct">obstruct<span class="rt">阻挠</span></span> its passage with <span data-readto data-word="vituperative">vituperative<span class="rt">辱骂的</span></span> floor speeches.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how" class="pt-[120px] pb-24 border-t border-[#e3dfd8] mt-20">
      <div class="max-w-[1180px] mx-auto px-6">
        <div class="flex items-baseline justify-between mb-14 gap-6">
          <div class="flex items-center gap-3 text-[11px] text-[#9a9489] tracking-[0.14em] uppercase font-semibold">
            <span class="inline-block w-6 h-px bg-[#b2462a]"></span>
            原理 · How it works
          </div>
          <h2 class="font-serif font-normal text-[44px] tracking-tight m-0 leading-[1.1] max-w-[580px]">
            读你本来就想读的，<br/>生词在<span class="not-italic text-[#b2462a]">阅读中</span>自然沉淀。
          </h2>
        </div>

        <div class="grid md:grid-cols-3 border-t border-[#ebe7df]">
          <!-- Feature 1 -->
          <div class="py-10 px-8 pb-2 min-h-[260px] flex flex-col gap-3 relative border-b md:border-b-0 md:border-r border-[#ebe7df] first:pl-0 last:pr-0 last:border-r-0">
            <div class="font-serif text-[13px] text-[#b2462a] font-medium tracking-[0.02em]">No. 01</div>
            <h3 class="font-serif font-medium text-[24px] m-0 tracking-tight leading-[1.25]">只标你不会的词</h3>
            <p class="mt-1.5 text-[#2b2824] text-[14px] leading-[1.65] max-w-[320px]">
              根据你选择的英语水平，跳过你已经会的，只在真正超纲的词上方加注。
            </p>
            <div class="font-serif text-[14px] text-[#141210] mt-auto pt-6 leading-[2] border-t border-dotted border-[#e3dfd8] w-full">
              He was <span data-readto class="annot-word" data-word="ostensibly">ostensibly<span class="rt">表面上</span></span> in charge, but the real power lay <span data-readto class="annot-word" data-word="elsewhere">elsewhere<span class="rt">别处</span></span>.
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="py-10 px-8 pb-2 min-h-[260px] flex flex-col gap-3 relative border-b md:border-b-0 md:border-r border-[#ebe7df] first:pl-0 last:pr-0 last:border-r-0">
            <div class="font-serif text-[13px] text-[#b2462a] font-medium tracking-[0.02em]">No. 02</div>
            <h3 class="font-serif font-medium text-[24px] m-0 tracking-tight leading-[1.25]">不打断你的阅读节奏</h3>
            <p class="mt-1.5 text-[#2b2824] text-[14px] leading-[1.65] max-w-[320px]">
              中文释义以小字标注在单词上方，不需要划词、点击或跳转词典。
            </p>
            <div class="font-serif text-[14px] text-[#141210] mt-auto pt-6 leading-[2] border-t border-dotted border-[#e3dfd8] w-full">
              The findings were <span data-readto class="annot-word" data-word="ambiguous">ambiguous<span class="rt">模糊的</span></span>, leaving room for <span data-readto class="annot-word" data-word="interpretation">interpretation<span class="rt">解读</span></span>.
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="py-10 px-8 pb-2 min-h-[260px] flex flex-col gap-3 relative first:pl-0 last:pr-0 last:border-r-0">
            <div class="font-serif text-[13px] text-[#b2462a] font-medium tracking-[0.02em]">No. 03</div>
            <h3 class="font-serif font-medium text-[24px] m-0 tracking-tight leading-[1.25]">任何英文页面都能用</h3>
            <p class="mt-1.5 text-[#2b2824] text-[14px] leading-[1.65] max-w-[320px]">
              新闻、博客、论文、小说——所有英文网页都支持。
            </p>
            <div class="flex flex-wrap gap-2 mt-auto pt-6 border-t border-dotted border-[#e3dfd8]">
              <span class="text-[12px] bg-[#ebe7df] px-2 py-1 rounded text-[#2b2824]">nytimes.com</span>
              <span class="text-[12px] bg-[#ebe7df] px-2 py-1 rounded text-[#2b2824]">medium.com</span>
              <span class="text-[12px] bg-[#ebe7df] px-2 py-1 rounded text-[#2b2824]">arxiv.org</span>
              <span class="text-[12px] bg-[#ebe7df] px-2 py-1 rounded text-[#2b2824]">wikipedia.org</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Read This Way -->
    <section class="py-24 border-t border-[#e3dfd8] bg-gradient-to-b from-[#f5f2eb] to-[#ebe7df]">
      <div class="max-w-[1180px] mx-auto px-6 grid md:grid-cols-[1fr_2fr] gap-14 items-start">
        <div class="text-[11px] text-[#9a9489] tracking-[0.14em] uppercase font-semibold">
          Why read this way
        </div>
        <div>
          <blockquote class="m-0 font-serif font-normal text-[36px] leading-[1.25] tracking-tight">
            背单词的最好方式，<br/>
            是在<span class="not-italic text-[#b2462a]">真实阅读</span>里反复遇到它。
          </blockquote>
          <cite class="block mt-5 text-[13px] text-[#9a9489] tracking-[0.02em] not-italic">
            — readto 的设计前提
          </cite>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-[#e3dfd8]">
    <div class="max-w-[1180px] mx-auto px-6 py-8 flex items-center justify-between">
      <a href={base} class="text-[14px] font-medium font-serif tracking-tight">
        readto<span class="text-[#b2462a]">.</span><span class="text-[0.7em] text-[#9a9489]">ai</span>
      </a>
      <div class="flex items-center gap-6">
        <a href={`${base}/privacy`} class="text-[12px] text-[#9a9489] hover:text-[#141210]">
          隐私政策
        </a>
        <span class="text-[12px] text-[#9a9489]">© 2026 · 读懂</span>
      </div>
    </div>
  </footer>

  <!-- Translation Tooltip - 匹配扩展结构 -->
  <div id="tooltip" class="tooltip hidden">
    <div class="phonetic">
      <button class="speaker" type="button" aria-label="Play pronunciation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
        </svg>
      </button>
      <span class="ipa"></span>
    </div>
    <div class="body"></div>
    <div class="examples"></div>
  </div>
</Layout>

<style is:global>
  /* 标注样式 - 完全匹配 readto 扩展 */
  :root {
    --readto-fg: #141210;
    --readto-fg-2: #2b2824;
    --readto-muted-2: #b8b3ac;
    --readto-rule: #e3dfd8;
    --readto-rule-2: #ebe7df;
    --readto-bg: #f5f2eb;
    --readto-card: #fbf9f4;
    --readto-ink: #111;
    --readto-annot: #9a9489;
    --readto-accent: #b2462a;
  }

  [data-readto] {
    white-space: nowrap;
    position: relative;
    cursor: pointer;
  }
  
  [data-readto]:hover {
    background: rgba(178, 70, 42, 0.08);
    border-radius: 2px;
  }
  
  .rt {
    display: inline;
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
    font-weight: 400;
    color: inherit;
    opacity: 0.85;
    margin-left: 1px;
    pointer-events: none;
    user-select: none;
  }

  /* Tooltip - 匹配扩展样式 */
  .tooltip {
    position: fixed;
    background: hsl(30 7% 97%);
    color: hsl(24 10% 10%);
    border: 1px solid hsl(25 6% 85%);
    border-radius: 6px;
    padding: 10px 12px;
    font-family: Charter, 'Iowan Old Style', 'Source Serif 4', Georgia, serif;
    font-size: 14px;
    line-height: 1.55;
    font-weight: 400;
    text-align: left;
    white-space: pre-wrap;
    min-width: 180px;
    max-width: 340px;
    box-shadow: 0 1px 2px rgba(24, 20, 18, 0.05), 0 6px 16px rgba(24, 20, 18, 0.06);
    z-index: 2147483647;
    user-select: text;
    pointer-events: auto;
    transition: opacity 0.15s, transform 0.15s;
  }
  
  .tooltip.show {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .tooltip .phonetic {
    display: flex;
    align-items: center;
    gap: 6px;
    color: hsl(25 5% 45%);
    margin-bottom: 6px;
  }

  .tooltip .ipa {
    font-style: italic;
  }

  .tooltip .speaker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 2px;
    margin: 0;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: inherit;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.08s;
  }

  .tooltip .speaker svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .tooltip .speaker:hover {
    background: rgba(24, 20, 18, 0.06);
    color: hsl(24 10% 10%);
  }

  .tooltip .speaker:active {
    transform: scale(0.9);
  }

  .tooltip .speaker.playing {
    color: #1a73e8;
    animation: readto-speaker-pulse 0.4s ease-out;
  }

  @keyframes readto-speaker-pulse {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.18); }
    100% { transform: scale(1); }
  }

  .tooltip .examples {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed hsl(25 6% 85%);
  }

  .tooltip .example {
    margin-top: 8px;
  }

  .tooltip .example:first-child {
    margin-top: 0;
  }

  .tooltip .example .en {
    font-size: 13px;
    line-height: 1.5;
    color: hsl(24 10% 18%);
  }

  .tooltip .example .target {
    font-weight: 600;
    color: #b2462a;
  }

  .tooltip .example .zh {
    font-size: 12px;
    line-height: 1.45;
    color: hsl(25 5% 50%);
    margin-top: 2px;
  }

  .slider-label {
    transition: color 0.2s, font-weight 0.2s;
  }
  .slider-label.active {
    color: #111;
    font-weight: 500;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    /* Header - 移动端简化 */
    header {
      padding: 12px 0;
    }
    
    header .max-w-\[1180px\] {
      padding: 0 16px;
      gap: 8px;
    }
    
    header .hidden.sm\:inline-block {
      display: none !important;
    }
    
    header nav {
      gap: 2px;
    }
    
    header nav a:not([class*="bg-"]) {
      font-size: 12px;
      padding: 4px 8px;
    }
    
    header nav a[class*="bg-"] {
      font-size: 12px;
      padding: 6px 12px;
    }

    /* Hero Section - 垂直堆叠 */
    section:first-of-type {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    
    section:first-of-type > div {
      gap: 32px;
    }

    h1 {
      font-size: 32px;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }

    h1 + p {
      font-size: 14px;
      max-width: 100%;
    }

    /* 安装按钮 */
    a[class*="bg-\[#111\]"][class*="text-white"] {
      display: inline-block;
      padding: 12px 24px;
      font-size: 14px;
    }

    /* Level Selector */
    .slider-label {
      font-size: 10px;
      padding: 8px 0;
    }

    #level-slider {
      height: 48px;
      margin-top: 8px;
    }

    #level-desc {
      font-size: 12px;
    }

    /* Article Preview - 移动端优化 */
    .bg-white.rounded-lg {
      border-radius: 8px;
    }

    #demo-content {
      font-size: 14px;
      line-height: 1.7;
      padding: 16px;
    }

    #demo-content h2 {
      font-size: 17px;
      margin-bottom: 4px;
    }

    #demo-content .text-\[13px\] {
      font-size: 12px;
      margin-bottom: 12px;
    }

    #demo-content p {
      margin-bottom: 12px;
      font-size: 14px;
    }

    /* Tooltip - 移动端适配 */
    .tooltip {
      min-width: 200px;
      max-width: calc(100vw - 32px);
      font-size: 14px;
      padding: 12px;
      border-radius: 8px;
    }

    .tooltip .phonetic {
      margin-bottom: 8px;
    }

    .tooltip .speaker {
      width: 28px;
      height: 28px;
    }

    .tooltip .speaker svg {
      width: 16px;
      height: 16px;
    }

    .tooltip .body {
      font-size: 14px;
      line-height: 1.5;
    }

    .tooltip .example .en {
      font-size: 13px;
    }

    .tooltip .example .zh {
      font-size: 12px;
    }

    /* Annotated Words - 增大触摸区域 */
    [data-readto] {
      -webkit-tap-highlight-color: transparent;
      padding: 4px 2px;
      margin: -4px -2px;
      display: inline;
    }

    .rt {
      font-size: 0.5em;
      margin-left: 0;
    }

    /* How It Works - 垂直堆叠 */
    #how {
      padding-top: 64px;
      padding-bottom: 48px;
      margin-top: 48px;
    }

    #how .max-w-\[1180px\] > .flex {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    #how h2 {
      font-size: 28px;
      line-height: 1.2;
    }

    #how .grid {
      grid-template-columns: 1fr;
    }

    #how .grid > div {
      padding: 24px 0;
      min-height: auto;
      border-right: none !important;
      border-bottom: 1px solid #ebe7df;
    }

    #how .grid > div:last-child {
      border-bottom: none;
    }

    #how h3 {
      font-size: 18px;
    }

    #how p {
      font-size: 14px;
    }

    /* Why Read This Way */
    section:has(blockquote) {
      padding: 48px 0;
    }

    blockquote {
      font-size: 24px;
      line-height: 1.35;
    }

    blockquote + cite {
      font-size: 12px;
      margin-top: 16px;
    }

    /* Footer - 垂直堆叠 */
    footer .flex.items-center.justify-between {
      flex-direction: column;
      gap: 16px;
      text-align: center;
      padding: 24px 16px;
    }
  }

  @media (prefers-color-scheme: dark) {
    .tooltip {
      background: hsl(24 10% 6%);
      color: hsl(30 7% 95%);
      border-color: hsl(24 6% 18%);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 6px 16px rgba(0, 0, 0, 0.45);
    }
    .tooltip .phonetic { color: hsl(25 5% 65%); }
    .tooltip .speaker:hover {
      background: rgba(245, 243, 240, 0.08);
      color: hsl(30 7% 95%);
    }
    .tooltip .speaker.playing { color: #66b1ff; }
    .tooltip .examples { border-top-color: hsl(24 6% 18%); }
    .tooltip .example .en { color: hsl(30 7% 90%); }
    .tooltip .example .target { color: #e07a5f; }
    .tooltip .example .zh { color: hsl(25 5% 65%); }
  }
</style>

<script>
  // 单词详情数据
  const wordDetails: Record<string, { p?: string; t: string; e?: Array<{ en: string; zh: string }> }> = {
    sweeping: {
      p: 'ˈswiːpɪŋ',
      t: 'adj. 大规模的；彻底的\nn. 扫除',
      e: [
        { en: 'The {sweeping} reforms changed the entire system.', zh: '大规模的改革改变了整个体制。' }
      ]
    },
    overhaul: {
      p: 'ˌoʊvərˈhɔːl',
      t: 'n. 大修；彻底检修\nv. 全面改革',
      e: [
        { en: 'The company needs to {overhaul} its management structure.', zh: '公司需要彻底改革其管理结构。' }
      ]
    },
    disproportionately: {
      p: 'ˌdɪsprəˈpɔːrʃənətli',
      t: 'adv. 不成比例地',
      e: [
        { en: 'The policy affected low-income families {disproportionately}.', zh: '这项政策对低收入家庭的影响不成比例。' }
      ]
    },
    profligate: {
      p: 'ˈprɒflɪɡət',
      t: 'adj. 挥霍的；浪费的',
      e: [
        { en: 'His {profligate} spending led to bankruptcy.', zh: '他挥霍无度导致破产。' }
      ]
    },
    austerity: {
      p: 'ɒˈsterəti',
      t: 'n. 紧缩；朴素；苦行',
      e: [
        { en: 'The government introduced {austerity} measures.', zh: '政府推出了紧缩措施。' }
      ]
    },
    burdened: {
      p: 'ˈbɜːrdnd',
      t: 'adj. 负担重的；受压迫的',
      e: [
        { en: 'She felt {burdened} by responsibility.', zh: '她感到责任重大。' }
      ]
    },
    stimulate: {
      p: 'ˈstɪmjuleɪt',
      t: 'v. 刺激；激发；促进',
      e: [
        { en: 'The policy aims to {stimulate} economic growth.', zh: '这项政策旨在刺激经济增长。' }
      ]
    },
    ameliorate: {
      p: 'əˈmiːliəreɪt',
      t: 'v. 改善；改进',
      e: [
        { en: 'Steps were taken to {ameliorate} working conditions.', zh: '采取了措施改善工作条件。' }
      ]
    },
    inequities: {
      p: 'ɪnˈekwətiz',
      t: 'n. 不公平；不公正',
      e: [
        { en: 'Social {inequities} persist despite progress.', zh: '尽管有进步，社会不公仍然存在。' }
      ]
    },
    fractious: {
      p: 'ˈfrækʃəs',
      t: 'adj. 难驾驭的；易怒的',
      e: [
        { en: 'The {fractious} debate lasted for hours.', zh: '这场难以驾驭的辩论持续了数小时。' }
      ]
    },
    polarized: {
      p: 'ˈpoʊləraɪzd',
      t: 'adj. 两极化的；偏振的',
      e: [
        { en: 'The issue has {polarized} public opinion.', zh: '这个问题使公众舆论两极化。' }
      ]
    },
    obstruct: {
      p: 'əbˈstrʌkt',
      t: 'v. 阻挠；妨碍；堵塞',
      e: [
        { en: 'The opposition tried to {obstruct} the bill.', zh: '反对派试图阻挠该法案。' }
      ]
    },
    vituperative: {
      p: 'vaɪˈtuːpərətɪv',
      t: 'adj. 辱骂的；责骂的',
      e: [
        { en: 'He launched a {vituperative} attack on his opponents.', zh: '他对对手发起了猛烈的抨击。' }
      ]
    },
    ostensibly: {
      p: 'ɑːˈstensɪbli',
      t: 'adv. 表面上；外表上；显然',
      e: [
        { en: 'He was {ostensibly} working, but actually watching videos.', zh: '他表面上在工作，实际上在看视频。' }
      ]
    },
    elsewhere: {
      p: 'ˈelswer',
      t: 'adv. 在别处；到别处',
      e: [
        { en: 'If you can\'t find it here, look {elsewhere}.', zh: '如果你在这里找不到，去别处看看。' }
      ]
    },
    ambiguous: {
      p: 'æmˈbɪɡjuəs',
      t: 'adj. 模棱两可的；含混不清的',
      e: [
        { en: 'The instructions were {ambiguous} and confusing.', zh: '说明含混不清，令人困惑。' }
      ]
    },
    interpretation: {
      p: 'ɪnˌtɜːrprɪˈteɪʃn',
      t: 'n. 解释；理解；诠释',
      e: [
        { en: 'Different people have different {interpretations} of the poem.', zh: '不同的人对这首诗有不同的理解。' }
      ]
    }
  };

  // Tooltip 元素 - 使用类名选择器匹配扩展结构
  const tooltip = document.getElementById('tooltip');
  const phonetic = tooltip?.querySelector('.phonetic');
  const ipa = tooltip?.querySelector('.ipa');
  const body = tooltip?.querySelector('.body');
  const examples = tooltip?.querySelector('.examples');
  const speaker = tooltip?.querySelector('.speaker');

  let activeTooltipWord: string | null = null;

  // 朗读功能 - 匹配扩展实现
  function speakWord(word: string) {
    if (!('speechSynthesis' in window)) return;
    
    speechSynthesis.cancel();
    
    const utterance = new SpeechSynthesisUtterance(word);
    utterance.lang = 'en-US';
    utterance.rate = 0.9;
    utterance.pitch = 1;
    
    const voices = speechSynthesis.getVoices();
    const enVoice = voices.find(v => v.lang.startsWith('en') && v.name.includes('Google')) ||
                    voices.find(v => v.lang.startsWith('en'));
    if (enVoice) utterance.voice = enVoice;
    
    speaker?.classList.remove('playing');
    void (speaker as HTMLElement)?.offsetWidth;
    speaker?.classList.add('playing');
    setTimeout(() => speaker?.classList.remove('playing'), 400);
    
    utterance.onend = () => speaker?.classList.remove('playing');
    utterance.onerror = () => speaker?.classList.remove('playing');
    
    speechSynthesis.speak(utterance);
  }

  speaker?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (activeTooltipWord) {
      speakWord(activeTooltipWord.toLowerCase());
    }
  });

  function showTooltip(word: string, rect: DOMRect) {
    const detail = wordDetails[word.toLowerCase()];
    if (!detail || !tooltip) return;

    cleanup();
    activeTooltipWord = word;

    if (detail.p && ipa && phonetic) {
      ipa.textContent = `/${detail.p}/`;
      phonetic.style.display = 'flex';
    } else if (phonetic) {
      phonetic.style.display = 'none';
    }

    if (body) {
      body.textContent = detail.t.replace(/\\n/g, '\n');
    }

    if (examples && detail.e?.length) {
      examples.innerHTML = '';
      for (const ex of detail.e) {
        const exDiv = document.createElement('div');
        exDiv.className = 'example';

        const enDiv = document.createElement('div');
        enDiv.className = 'en';
        const segments = ex.en.split(/\{([^}]+)\}/g);
        segments.forEach((seg, i) => {
          if (i % 2 === 0) {
            enDiv.appendChild(document.createTextNode(seg));
          } else {
            const targetSpan = document.createElement('span');
            targetSpan.className = 'target';
            targetSpan.textContent = seg;
            enDiv.appendChild(targetSpan);
          }
        });
        exDiv.appendChild(enDiv);

        const zhDiv = document.createElement('div');
        zhDiv.className = 'zh';
        zhDiv.textContent = ex.zh;
        exDiv.appendChild(zhDiv);

        examples.appendChild(exDiv);
      }
      examples.style.display = 'block';
    } else if (examples) {
      examples.style.display = 'none';
    }

    const GAP = 8;
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    tooltip.style.visibility = 'hidden';
    tooltip.classList.remove('hidden');
    
    const tipRect = tooltip.getBoundingClientRect();
    
    let top = rect.bottom + GAP;
    let left = rect.left + (rect.width - tipRect.width) / 2;

    if (top + tipRect.height > vh - GAP) {
      top = rect.top - tipRect.height - GAP;
    }

    left = Math.max(GAP, Math.min(left, vw - tipRect.width - GAP));

    tooltip.style.top = `${top}px`;
    tooltip.style.left = `${left}px`;
    tooltip.style.visibility = '';
    tooltip.classList.add('show');

    // 自动隐藏 30 秒
    activeAutoHideTimer = setTimeout(cleanup, 30_000);
  }

  let activeAutoHideTimer: ReturnType<typeof setTimeout> | null = null;

  function cleanup() {
    if (activeAutoHideTimer) {
      clearTimeout(activeAutoHideTimer);
      activeAutoHideTimer = null;
    }
    
    if (tooltip) {
      tooltip.classList.remove('show');
      tooltip.classList.add('hidden');
    }
    activeTooltipWord = null;
  }

  function bindAnnotationClicks() {
    // 匹配扩展的 hover + click 行为
    const HOVER_SHOW_DELAY = 150;
    const HOVER_HIDE_DELAY = 120;
    
    let showTimer: ReturnType<typeof setTimeout> | null = null;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let isPinned = false;
    let currentHoverEl: Element | null = null;

    const clearShow = () => {
      if (showTimer !== null) { clearTimeout(showTimer); showTimer = null; }
    };
    const clearHide = () => {
      if (hideTimer !== null) { clearTimeout(hideTimer); hideTimer = null; }
    };

    const scheduleHide = () => {
      clearHide();
      hideTimer = setTimeout(() => {
        hideTimer = null;
        if (isPinned) return;
        cleanup();
      }, HOVER_HIDE_DELAY);
    };

    document.querySelectorAll('[data-readto]').forEach(el => {
      const word = el.getAttribute('data-word') || '';

      // Hover: 延迟显示 tooltip
      el.addEventListener('pointerenter', () => {
        currentHoverEl = el;
        clearShow();
        clearHide();
        showTimer = setTimeout(() => {
          showTimer = null;
          const rect = el.getBoundingClientRect();
          showTooltip(word, rect);
        }, HOVER_SHOW_DELAY);
      });

      // Hover leave: 延迟隐藏
      el.addEventListener('pointerleave', () => {
        currentHoverEl = null;
        clearShow();
        if (!isPinned) scheduleHide();
      });

      // Click: pin/unpin（移动端也用 click）
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        if (isPinned && activeTooltipWord === word.toLowerCase()) {
          // Unpin
          isPinned = false;
          scheduleHide();
        } else {
          // Pin
          isPinned = true;
          clearHide();
          clearShow();
          const rect = el.getBoundingClientRect();
          showTooltip(word, rect);
        }
      });
    });

    // Tooltip hover: 保持显示
    tooltip?.addEventListener('pointerenter', () => {
      clearHide();
      clearShow();
    });

    tooltip?.addEventListener('pointerleave', () => {
      if (!isPinned) scheduleHide();
    });

    // 点击外部关闭
    document.addEventListener('mousedown', (e) => {
      const target = e.target as Element;
      if (target.closest('[data-readto]')) return;
      if (tooltip?.contains(target)) return;
      isPinned = false;
      cleanup();
    });

    // Escape 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        isPinned = false;
        cleanup();
      }
    });

    // 滚动关闭
    window.addEventListener('scroll', () => {
      isPinned = false;
      cleanup();
    }, { passive: true });
  }
  bindAnnotationClicks();

  // ─── Level Slider ───────────────────────────────────────────────────
  const slider = document.getElementById('level-slider');
  const knob = document.getElementById('knob');
  const trackFill = document.getElementById('track-fill');
  const levelDesc = document.getElementById('level-desc');
  const demoContent = document.getElementById('demo-content');
  const sliderLabels = document.querySelectorAll('.slider-label');

  const levelDescs = [
    '只标最基础的词。',
    '标高考以下的词。',
    '只标大学四六级以上的词。',
    '标雅思托福以上的词。',
    '只标最生僻的词。',
  ];

  let currentLevel = 2;

  function getPercent(level: number): number {
    return 10 + (level / 4) * 80;
  }

  // 每个等级显示的单词（等级越高，显示的单词越少越难）
  const levelWords: string[][] = [
    // 入门：显示所有词
    ['sweeping', 'overhaul', 'disproportionately', 'profligate', 'austerity', 'burdened', 'stimulate', 'ameliorate', 'inequities', 'fractious', 'polarized', 'obstruct', 'vituperative'],
    // 基础：去掉最简单的
    ['overhaul', 'disproportionately', 'profligate', 'austerity', 'ameliorate', 'inequities', 'fractious', 'polarized', 'obstruct', 'vituperative'],
    // 进阶：中级词汇
    ['profligate', 'austerity', 'ameliorate', 'fractious', 'vituperative'],
    // 熟练：高级词汇
    ['profligate', 'fractious', 'vituperative'],
    // 精通：最难的词
    ['vituperative'],
  ];

  function updateAnnotations(level: number) {
    if (!demoContent) return;
    
    const showWords = levelWords[level] || levelWords[2];
    
    demoContent.querySelectorAll('[data-readto]').forEach(el => {
      const word = el.getAttribute('data-word');
      if (word && showWords.includes(word)) {
        el.style.display = '';
        // 显示 rt
        const rt = el.querySelector('.rt');
        if (rt) rt.style.display = '';
      } else if (word) {
        // 隐藏 rt 但保留文字
        const rt = el.querySelector('.rt');
        if (rt) rt.style.display = 'none';
      }
    });
  }

  function updateSlider(level: number, save = true) {
    currentLevel = level;
    const percent = getPercent(level);

    if (knob) knob.style.left = `${percent}%`;
    if (trackFill) trackFill.style.width = `${percent}%`;

    sliderLabels.forEach((label, i) => {
      if (i === level) {
        label.classList.add('active', 'text-[#111]', 'font-medium');
        label.classList.remove('text-[#b8b3ac]');
      } else {
        label.classList.remove('active', 'text-[#111]', 'font-medium');
        label.classList.add('text-[#b8b3ac]');
      }
    });

    if (levelDesc) levelDesc.textContent = levelDescs[level];
    if (slider) {
      slider.setAttribute('aria-valuenow', String(level + 1));
      slider.setAttribute('aria-valuetext', ['入门', '基础', '进阶', '熟练', '精通'][level]);
    }

    // 联动更新标注
    updateAnnotations(level);

    // 持久化到 localStorage
    if (save) {
      try {
        localStorage.setItem('readto-level', String(level));
      } catch {}
    }
  }

  function percentToLevel(percent: number): number {
    const positions = [10, 30, 50, 70, 90];
    let closest = 0;
    let minDist = Infinity;
    positions.forEach((pos, i) => {
      const dist = Math.abs(percent - pos);
      if (dist < minDist) {
        minDist = dist;
        closest = i;
      }
    });
    return closest;
  }

  function pointerToLevel(clientX: number): number {
    if (!slider) return currentLevel;
    const rect = slider.getBoundingClientRect();
    const percent = ((clientX - rect.left) / rect.width) * 100;
    return percentToLevel(Math.max(10, Math.min(90, percent)));
  }

  let isDragging = false;

  slider?.addEventListener('mousedown', (e) => {
    isDragging = true;
    updateSlider(pointerToLevel(e.clientX));
    e.preventDefault();
  });

  document.addEventListener('mousemove', (e) => {
    if (isDragging) updateSlider(pointerToLevel(e.clientX));
  });

  document.addEventListener('mouseup', () => { isDragging = false; });

  slider?.addEventListener('touchstart', (e) => {
    isDragging = true;
    updateSlider(pointerToLevel(e.touches[0].clientX));
    e.preventDefault();
  }, { passive: false });

  document.addEventListener('touchmove', (e) => {
    if (isDragging) updateSlider(pointerToLevel(e.touches[0].clientX));
  }, { passive: true });

  document.addEventListener('touchend', () => { isDragging = false; });

  slider?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
      updateSlider(Math.min(4, currentLevel + 1));
      e.preventDefault();
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
      updateSlider(Math.max(0, currentLevel - 1));
      e.preventDefault();
    }
  });

  sliderLabels.forEach((label, i) => {
    label.addEventListener('click', () => updateSlider(i));
  });

  // 初始化：从 localStorage 读取保存的等级
  let savedLevel = 2; // 默认进阶
  try {
    const stored = localStorage.getItem('readto-level');
    if (stored !== null) {
      const parsed = parseInt(stored, 10);
      if (parsed >= 0 && parsed <= 4) {
        savedLevel = parsed;
      }
    }
  } catch {}
  updateSlider(savedLevel, false);
</script>
