---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const rootPath = base.replace(/\/$/, "");
const privacyHref = `${rootPath}/privacy`;
const howHref = `${base}#how`;
---

<Layout>
  <!-- Navigation -->
  <header
    class="sticky top-0 z-50 border-b border-readto-rule bg-readto-bg/95 backdrop-blur-sm"
  >
    <div
      class="max-w-content mx-auto flex items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
    >
      <div class="flex min-w-0 items-baseline gap-4">
        <a
          href={base}
          class="inline-flex items-baseline font-serif text-[20px] font-medium tracking-tight text-readto-fg"
        >
          readto<span class="text-[#b2462a] font-semibold">.</span><span
            class="ml-[2px] text-[0.7em] tracking-normal font-normal text-[#9a9489]"
            >ai</span
          >
        </a>
        <div class="hidden text-[11px] text-readto-muted md:inline-block">
          读懂每一个词 · Read to know
        </div>
      </div>
      <nav class="flex items-center gap-3 sm:gap-5">
        <a
          href={howHref}
          class="hidden text-[12px] text-readto-fg-2 transition-colors hover:text-readto-ink sm:inline"
        >
          工作原理
        </a>
        <a
          href={privacyHref}
          class="text-[12px] text-readto-fg-2 transition-colors hover:text-readto-ink"
        >
          隐私政策
        </a>
        <a
          href="https://chromewebstore.google.com/detail/readto/hmoifnkckggncdpoplpoiifjafffmkof"
          class="whitespace-nowrap rounded-full bg-readto-ink px-3 py-1.5 text-[12px] text-white transition-opacity hover:opacity-90 sm:px-3.5"
        >
          安装扩展 →
        </a>
      </nav>
    </div>
  </header>

  <main class="relative isolate overflow-hidden">
    <figure
      class="absolute inset-0 z-0 pointer-events-none opacity-10 mix-blend-screen"
      aria-hidden="true"
    >
      <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
        <filter id="noise-bg-fx">
          <feTurbulence baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
          <feColorMatrix type="saturate" values="0" />
        </filter>
        <rect width="100%" height="100%" filter="url(#noise-bg-fx)"></rect>
      </svg>
    </figure>
    <!-- Hero Section -->
    <section
      class="relative z-10 max-w-content mx-auto px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-16"
    >
      <div class="grid items-center gap-10 md:grid-cols-[0.95fr_1.05fr] md:gap-12">
        <!-- Left: Description -->
        <div>
          <p
            class="text-[11px] text-readto-muted tracking-[0.14em] uppercase font-semibold mb-6"
          >
            A CHROME EXTENSION · 浏览器扩展
          </p>
          <h1
            class="font-serif font-normal text-[32px] md:text-[56px] leading-[1.05] tracking-tight m-0 mb-6"
          >
            Read to know.<br />
            <span class="whitespace-nowrap font-medium">读懂每一个词。</span>
          </h1>
          <p
            class="mb-6 max-w-md text-[15px] leading-[1.75] text-readto-fg-2"
          >
            在任何英文网页上，readto
            会根据你的英语水平，悄悄在生词上方标好中文小注。不划词、不跳窗、不中断阅读。
          </p>
          <a
            href="https://chromewebstore.google.com/detail/readto/hmoifnkckggncdpoplpoiifjafffmkof"
            class="inline-block rounded-full bg-readto-ink px-6 py-3 text-center text-[14px] font-medium text-white transition-opacity hover:opacity-90"
          >
            安装 Chrome 扩展 →
          </a>

          <!-- Level Selector -->
          <div class="mt-10 sm:mt-14">
            <p
              class="text-[11px] text-readto-muted tracking-[0.14em] uppercase font-semibold mb-4"
            >
              YOUR LEVEL · 你的水平
            </p>

            <div class="level-scale" aria-hidden="true">
              <!-- Slider Labels: share exact stop positions with ticks/knob -->
              <span class="slider-label" data-index="0" style="--pos: 0%">入门</span>
              <span class="slider-label" data-index="1" style="--pos: 25%">基础</span>
              <span class="slider-label" data-index="2" style="--pos: 50%">进阶</span>
              <span class="slider-label" data-index="3" style="--pos: 75%">熟练</span>
              <span class="slider-label" data-index="4" style="--pos: 100%">精通</span>
            </div>

            <!-- Custom Slider -->
            <div
              class="level-scale level-slider"
              role="slider"
              tabindex="0"
              aria-label="英语水平"
              aria-valuemin="1"
              aria-valuemax="5"
              aria-valuenow="3"
              aria-valuetext="进阶"
              id="level-slider"
            >
              <!-- Track -->
              <div class="slider-track"></div>
              <div class="slider-track-fill" id="track-fill" style="width:50%"></div>

              <!-- Tick Marks: same 0/25/50/75/100 positions -->
              <span class="slider-tick strong" style="--pos: 0%"></span>
              <span class="slider-tick" style="--pos: 25%"></span>
              <span class="slider-tick" style="--pos: 50%"></span>
              <span class="slider-tick" style="--pos: 75%"></span>
              <span class="slider-tick strong" style="--pos: 100%"></span>

              <!-- Knob -->
              <div class="slider-knob" id="knob" style="left:50%"></div>
            </div>

            <p
              class="text-[14px] text-readto-muted mt-3"
              id="level-desc"
            >
              只标大学四六级以上的词。
            </p>
          </div>
        </div>

        <!-- Right: Browser Mockup -->
        <div
          class="overflow-hidden rounded-[14px] border border-readto-rule bg-readto-card shadow-[0_10px_36px_rgba(20,18,16,0.07)]"
        >
          <div
            class="flex items-center gap-2 border-b border-readto-rule bg-readto-bg px-3 py-2"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
            <span
              class="flex-1 bg-readto-rule-2 rounded px-3 py-1 text-xs text-readto-muted ml-2"
            >
              /politics/tax-reform-bill.html
            </span>
          </div>
          <div
            class="p-4 font-sans text-[15px] leading-[1.72] sm:p-5"
            id="demo-content"
          >
            <div
              class="text-[11px] text-readto-muted uppercase tracking-[0.14em] font-semibold mb-2"
            >
              Politics
            </div>
            <h2
              class="font-semibold text-[15px] tracking-tight mb-0.5 text-readto-ink"
            >
              President Announces Sweeping Tax Reforms
            </h2>
            <p class="text-[12px] text-readto-muted-2 mb-3">
              By Anna Reed · April 22, 2026
            </p>

            <p class="text-readto-fg mb-3">
              <span data-readto data-word="the"
                >The<span class="rt">定冠词</span></span
              >
              <span data-readto data-word="president"
                >president<span class="rt">总统</span></span
              >
              <span data-readto data-word="announced"
                >announced<span class="rt">宣布</span></span
              >
              <span data-readto data-word="sweeping"
                >sweeping<span class="rt">影响广泛的</span></span
              >
              <span data-readto data-word="reforms"
                >reforms<span class="rt">改革</span></span
              > to the <span data-readto data-word="nation"
                >nation<span class="rt">国家</span></span
              >'s <span data-readto data-word="tax"
                >tax<span class="rt">税</span></span
              >
              <span data-readto data-word="system"
                >system<span class="rt">系统</span></span
              >
              <span data-readto data-word="yesterday"
                >yesterday<span class="rt">昨天</span></span
              >, <span data-readto data-word="marking"
                >marking<span class="rt">标记</span></span
              > the most <span data-readto data-word="significant"
                >significant<span class="rt">重要的</span></span
              >
              <span data-readto data-word="overhaul"
                >overhaul<span class="rt">彻底检修</span></span
              > in a <span data-readto data-word="decade"
                >decade<span class="rt">十年</span></span
              >.
            </p>
            <p class="text-readto-fg mb-3">
              <span data-readto data-word="critics"
                >Critics<span class="rt">评论家</span></span
              >
              <span data-readto data-word="denounce"
                >denounce<span class="rt">公开谴责</span></span
              > the <span data-readto data-word="changes"
                >changes<span class="rt">变化</span></span
              > as <span data-readto data-word="disproportionately"
                >disproportionately<span class="rt">不成比例地</span></span
              >
              <span data-readto data-word="benefiting"
                >benefiting<span class="rt">受益</span></span
              >
              <span data-readto data-word="wealthy"
                >wealthy<span class="rt">富有的</span></span
              >
              <span data-readto data-word="citizens"
                >citizens<span class="rt">公民</span></span
              >, <span data-readto data-word="accusing"
                >accusing<span class="rt">责备的</span></span
              > the <span data-readto data-word="administration"
                >administration<span class="rt">管理</span></span
              > of <span data-readto data-word="profligate"
                >profligate<span class="rt">挥霍的</span></span
              >
              <span data-readto data-word="giveaways"
                >giveaways<span class="rt">赠品</span></span
              > and <span data-readto data-word="austerity"
                >austerity<span class="rt">经济紧缩</span></span
              > toward <span data-readto data-word="middle"
                >middle<span class="rt">中间</span></span
              >-class <span data-readto data-word="families"
                >families<span class="rt">家庭</span></span
              > already <span data-readto data-word="burdened"
                >burdened<span class="rt">负担沉重的</span></span
              > by <span data-readto data-word="rising"
                >rising<span class="rt">上升的</span></span
              >
              <span data-readto data-word="costs"
                >costs<span class="rt">费用</span></span
              >.
            </p>
            <p class="text-readto-fg mb-3">
              <span data-readto data-word="proponents"
                >Proponents<span class="rt">支持者</span></span
              >
              <span data-readto data-word="counter"
                >counter<span class="rt">反驳</span></span
              > that <span data-readto data-word="lower"
                >lower<span class="rt">降低</span></span
              >
              <span data-readto data-word="taxes"
                >taxes<span class="rt">税款</span></span
              > will <span data-readto data-word="stimulate"
                >stimulate<span class="rt">刺激</span></span
              >
              <span data-readto data-word="investment"
                >investment<span class="rt">投资</span></span
              > and <span data-readto data-word="ameliorate"
                >ameliorate<span class="rt">改善</span></span
              > broader inequities.
            </p>
            <p class="text-readto-fg mb-3">
              The <span data-readto data-word="bill"
                >bill<span class="rt">法案</span></span
              >
              <span data-readto data-word="faces"
                >faces<span class="rt">面对</span></span
              > a <span data-readto data-word="difficult"
                >difficult<span class="rt">困难的</span></span
              >
              <span data-readto data-word="path"
                >path<span class="rt">路径</span></span
              >
              <span data-readto data-word="through"
                >through<span class="rt">穿过</span></span
              > the <span data-readto data-word="fractious"
                >fractious<span class="rt">易怒的</span></span
              >, <span data-readto data-word="polarized"
                >polarized<span class="rt">极化的</span></span
              >
              <span data-readto data-word="legislature"
                >legislature<span class="rt">立法机关</span></span
              >, where <span data-readto data-word="opposition"
                >opposition<span class="rt">反对</span></span
              >
              <span data-readto data-word="lawmakers"
                >lawmakers<span class="rt">立法者</span></span
              > have <span data-readto data-word="vowed"
                >vowed<span class="rt">发誓</span></span
              > to <span data-readto data-word="obstruct"
                >obstruct<span class="rt">阻碍</span></span
              > its <span data-readto data-word="passage"
                >passage<span class="rt">通过</span></span
              > with <span data-readto data-word="vituperative"
                >vituperative<span class="rt">谩骂的</span></span
              >
              <span data-readto data-word="floor"
                >floor<span class="rt">议会</span></span
              >
              <span data-readto data-word="speeches"
                >speeches<span class="rt">演讲</span></span
              >.
            </p>
            <p class="text-readto-fg">
              Despite a <span data-readto data-word="flurry"
                >flurry<span class="rt">一阵</span></span
              > of <span data-readto data-word="grassroots"
                >grassroots<span class="rt">草根的</span></span
              >
              <span data-readto data-word="rhetoric"
                >rhetoric<span class="rt">修辞</span></span
              >, <span data-readto data-word="recent"
                >recent<span class="rt">最近的</span></span
              >
              <span data-readto data-word="polls"
                >polls<span class="rt">民意调查</span></span
              >
              <span data-readto data-word="indicate"
                >indicate<span class="rt">表明</span></span
              >
              <span data-readto data-word="voters"
                >voters<span class="rt">选民</span></span
              >
              <span data-readto data-word="remain"
                >remain<span class="rt">保持</span></span
              > deeply <span data-readto data-word="skeptical"
                >skeptical<span class="rt">怀疑的</span></span
              > of what they <span data-readto data-word="view"
                >view<span class="rt">看待</span></span
              > as <span data-readto data-word="perfunctory"
                >perfunctory<span class="rt">敷衍的</span></span
              >
              <span data-readto data-word="concessions"
                >concessions<span class="rt">让步</span></span
              >, <span data-readto data-word="leaving"
                >leaving<span class="rt">留下</span></span
              >
              <span data-readto data-word="negotiations"
                >negotiations<span class="rt">谈判</span></span
              > at a <span data-readto data-word="fragile"
                >fragile<span class="rt">脆弱的</span></span
              >
              <span data-readto data-word="impasse"
                >impasse<span class="rt">僵局</span></span
              >.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section
      id="how"
      class="relative z-10 mt-12 border-t border-readto-rule py-16 sm:mt-16"
    >
      <div class="max-w-content mx-auto px-4 sm:px-6">
        <div
          class="flex flex-col md:flex-row items-start md:items-baseline justify-between mb-10 md:mb-14 gap-6"
        >
          <div
            class="flex items-center gap-3 text-[11px] text-readto-muted tracking-[0.14em] uppercase font-semibold"
          >
            <span class="inline-block w-6 h-px bg-readto-accent"></span>
            原理 · How it works
          </div>
          <h2
            class="font-serif font-normal text-[32px] md:text-[44px] tracking-tight m-0 leading-[1.1] max-w-lg"
          >
            读你本来就想读的，<br />生词在<span
              class="not-italic text-readto-accent">阅读中</span
            >自然沉淀。
          </h2>
        </div>

        <div class="grid md:grid-cols-3 border-t border-readto-rule-2">
          <!-- Feature 1 -->
          <div
            class="relative flex min-h-[240px] flex-col gap-3 border-b border-readto-rule-2 py-8 md:border-b-0 md:border-r md:px-8 md:first:pl-0 md:last:pr-0 last:border-r-0"
          >
            <div
              class="font-serif text-sm text-readto-accent font-medium tracking-[0.02em]"
            >
              No. 01
            </div>
            <h3
              class="font-serif font-medium text-[18px] m-0 tracking-tight leading-snug"
            >
              只标你不会的词
            </h3>
            <p
              class="mt-1.5 text-readto-fg-2 text-[14px] leading-[1.65] max-w-xs"
            >
              根据你选择的英语水平，跳过你已经会的，只在真正超纲的词上方加注。
            </p>
            <div
              class="font-serif text-sm text-readto-fg mt-auto pt-6 leading-8 border-t border-dotted border-readto-rule w-full"
            >
              He was <span data-readto class="annot-word" data-word="ostensibly"
                >ostensibly<span class="rt">表面上</span></span
              > in charge, but the real power lay <span
                data-readto
                class="annot-word"
                data-word="elsewhere"
                >elsewhere<span class="rt">别处</span></span
              >.
            </div>
          </div>

          <!-- Feature 2 -->
          <div
            class="relative flex min-h-[240px] flex-col gap-3 border-b border-readto-rule-2 py-8 md:border-b-0 md:border-r md:px-8 md:first:pl-0 md:last:pr-0 last:border-r-0"
          >
            <div
              class="font-serif text-sm text-readto-accent font-medium tracking-[0.02em]"
            >
              No. 02
            </div>
            <h3
              class="font-serif font-medium text-xl m-0 tracking-tight leading-snug"
            >
              不打断你的阅读节奏
            </h3>
            <p class="mt-1.5 text-readto-fg-2 text-sm leading-relaxed max-w-xs">
              中文释义以小字标注在单词上方，不需要划词、点击或跳转词典。
            </p>
            <div
              class="font-serif text-sm text-readto-fg mt-auto pt-6 leading-8 border-t border-dotted border-readto-rule w-full"
            >
              The findings were <span
                data-readto
                class="annot-word"
                data-word="ambiguous"
                >ambiguous<span class="rt">模糊的</span></span
              >, leaving room for <span
                data-readto
                class="annot-word"
                data-word="interpretation"
                >interpretation<span class="rt">解读</span></span
              >.
            </div>
          </div>

          <!-- Feature 3 -->
          <div
            class="relative flex min-h-[240px] flex-col gap-3 py-8 md:px-8 md:first:pl-0 md:last:pr-0 last:border-r-0"
          >
            <div
              class="font-serif text-sm text-readto-accent font-medium tracking-[0.02em]"
            >
              No. 03
            </div>
            <h3
              class="font-serif font-medium text-xl m-0 tracking-tight leading-snug"
            >
              任何英文页面都能用
            </h3>
            <p class="mt-1.5 text-readto-fg-2 text-sm leading-relaxed max-w-xs">
              新闻、博客、论文、小说——所有英文网页都支持。
            </p>
            <div
              class="flex flex-wrap gap-2 mt-auto pt-6 border-t border-dotted border-readto-rule"
            >
              <span
                class="text-xs bg-readto-rule-2 px-2 py-1 rounded text-readto-fg-2"
                >nytimes.com</span
              >
              <span
                class="text-xs bg-readto-rule-2 px-2 py-1 rounded text-readto-fg-2"
                >medium.com</span
              >
              <span
                class="text-xs bg-readto-rule-2 px-2 py-1 rounded text-readto-fg-2"
                >arxiv.org</span
              >
              <span
                class="text-xs bg-readto-rule-2 px-2 py-1 rounded text-readto-fg-2"
                >wikipedia.org</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Read This Way -->
    <section
      class="relative z-10 border-t border-readto-rule bg-readto-card py-16"
    >
      <div
        class="max-w-content mx-auto px-4 sm:px-6 grid md:grid-cols-[1fr_2fr] gap-8 items-start"
      >
        <div
          class="text-[11px] text-readto-muted tracking-[0.14em] uppercase font-semibold"
        >
          Why read this way
        </div>
        <div>
          <blockquote
            class="m-0 font-serif font-normal text-[32px] md:text-[44px] leading-[1.2] tracking-tight"
          >
            背单词的最好方式，<br />
            是在<span class="not-italic text-readto-accent">真实阅读</span
            >里反复遇到它。
          </blockquote>
          <cite
            class="block mt-5 text-sm text-readto-muted tracking-[0.02em] not-italic"
          >
            — readto 的设计前提
          </cite>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-readto-rule">
    <div
      class="max-w-content mx-auto px-4 sm:px-6 py-6 sm:py-8 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <a href={base} class="text-[14px] font-medium font-serif tracking-tight">
        readto<span class="text-readto-accent">.</span><span
          class="text-[0.7em] text-readto-muted">ai</span
        >
      </a>
      <div class="flex items-center gap-6">
        <a
          href={privacyHref}
          class="text-[12px] text-readto-muted hover:text-readto-fg"
        >
          隐私政策
        </a>
        <span class="text-[12px] text-readto-muted">© 2026 · 读懂</span>
      </div>
    </div>
  </footer>

  <!-- Translation Tooltip -->
  <div id="tooltip" class="tooltip hidden">
    <div class="phonetic">
      <button class="speaker" type="button" aria-label="Play pronunciation">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
          ></path>
        </svg>
      </button>
      <span class="ipa"></span>
    </div>
    <div class="body"></div>
    <div class="examples"></div>
  </div>
</Layout>

<script>
  // 从扩展项目 level-data-full.json + translations-detail 导出
  const LEVEL_ORDER: Record<string, number> = {
    A1: 1,
    A2: 2,
    B1: 3,
    B2: 4,
    C1: 5,
    C2: 6,
