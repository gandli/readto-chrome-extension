  // Tooltip 元素
  const tooltip = document.getElementById("tooltip");
  const phonetic = tooltip?.querySelector(".phonetic");
  const ipa = tooltip?.querySelector(".ipa");
  const body = tooltip?.querySelector(".body");
  const examples = tooltip?.querySelector(".examples");
  const speaker = tooltip?.querySelector(".speaker");

  let activeTooltipWord: string | null = null;
  const speechSupported =
    "speechSynthesis" in window && "SpeechSynthesisUtterance" in window;
  let cachedEnglishVoice: SpeechSynthesisVoice | null = null;
  let voicesReadyPromise: Promise<SpeechSynthesisVoice[]> | null = null;

  const preferredVoicePatterns = [
    /google\s+(us|uk).*english/i,
    /microsoft\s+(aria|jenny|guy|zira|david|mark)/i,
    /samantha|alex|daniel|karen|moira|tessa|veena/i,
    /natural|premium|neural/i,
  ];

  function scoreEnglishVoice(voice: SpeechSynthesisVoice): number {
    const lang = voice.lang.toLowerCase();
    const name = voice.name.toLowerCase();
    if (!lang.startsWith("en")) return -1;

    let score = 40;
    if (lang === "en-us") score += 40;
    else if (lang === "en-gb") score += 32;
    else if (lang.startsWith("en-")) score += 24;

    preferredVoicePatterns.forEach((pattern, index) => {
      if (pattern.test(name)) score += 24 - index * 4;
    });
    if (voice.localService) score += 4;
    if (voice.default) score += 3;
    return score;
  }

  function getSortedEnglishVoices(): SpeechSynthesisVoice[] {
    if (!speechSupported) return [];
    return window.speechSynthesis
      .getVoices()
      .filter((voice) => scoreEnglishVoice(voice) >= 0)
      .sort((a, b) => scoreEnglishVoice(b) - scoreEnglishVoice(a));
  }

  function getEnglishVoice(): SpeechSynthesisVoice | null {
    const [bestVoice] = getSortedEnglishVoices();
    cachedEnglishVoice = bestVoice || cachedEnglishVoice || null;
    if (cachedEnglishVoice && speaker) {
      speaker.setAttribute("title", `朗读音源：${cachedEnglishVoice.name}`);
      speaker.setAttribute("aria-disabled", "false");
      speaker.classList.remove("unsupported");
    }
    return cachedEnglishVoice;
  }

  function markSpeechUnsupported(reason = "当前浏览器不支持系统朗读") {
    speaker?.setAttribute("aria-disabled", "true");
    speaker?.setAttribute("title", reason);
    speaker?.classList.add("unsupported");
  }

  function waitForVoices(timeout = 900): Promise<SpeechSynthesisVoice[]> {
    if (!speechSupported) return Promise.resolve([]);
    const voices = window.speechSynthesis.getVoices();
    if (voices.length > 0) return Promise.resolve(voices);
    if (voicesReadyPromise) return voicesReadyPromise;

    voicesReadyPromise = new Promise((resolve) => {
      const finish = () => {
        window.clearTimeout(timer);
        window.speechSynthesis.removeEventListener?.("voiceschanged", finish);
        voicesReadyPromise = null;
        resolve(window.speechSynthesis.getVoices());
      };
      const timer = window.setTimeout(finish, timeout);
      window.speechSynthesis.addEventListener?.("voiceschanged", finish, { once: true });
    });
    return voicesReadyPromise;
  }

  if (speechSupported) {
    speaker?.setAttribute("title", "点击朗读英文单词");
    speaker?.setAttribute("aria-disabled", "false");
    getEnglishVoice();
    window.speechSynthesis.addEventListener?.("voiceschanged", getEnglishVoice);
    void waitForVoices(1_200).then(() => getEnglishVoice());
  } else {
    markSpeechUnsupported();
  }

  // 朗读功能：浏览器原生 Web Speech API；音源按质量排序，兼容 Chrome / Edge / Safari / Firefox voices 异步加载。
  async function speakWord(word: string) {
    const text = word.trim().toLowerCase();
    if (!text) return;
    if (!speechSupported) {
      markSpeechUnsupported();
      return;
    }

    const synth = window.speechSynthesis;
    await waitForVoices();
    const enVoice = getEnglishVoice();

    synth.cancel();
    synth.resume?.();

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = enVoice?.lang || "en-US";
    utterance.rate = 0.88;
    utterance.pitch = 1;
    utterance.volume = 1;
    if (enVoice) utterance.voice = enVoice;

    speaker?.classList.remove("playing", "unsupported");
    void (speaker as HTMLElement)?.offsetWidth;
    speaker?.classList.add("playing");
    const clearPlaying = () => speaker?.classList.remove("playing");
    const fallbackTimer = window.setTimeout(clearPlaying, 1800);
    utterance.onend = () => {
      window.clearTimeout(fallbackTimer);
      clearPlaying();
    };
    utterance.onerror = () => {
      window.clearTimeout(fallbackTimer);
      clearPlaying();
    };

    try {
      synth.speak(utterance);
      // Safari / iOS 有时会把队列置为 paused；用户点击事件后立即 resume 更稳。
      window.setTimeout(() => synth.resume?.(), 0);
      window.setTimeout(() => {
        if (synth.paused) synth.resume?.();
      }, 250);
    } catch {
      window.clearTimeout(fallbackTimer);
      clearPlaying();
      markSpeechUnsupported("当前浏览器阻止了朗读，请换用 Chrome / Edge / Safari 重试");
    }
  }

  speaker?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (activeTooltipWord) void speakWord(activeTooltipWord);
  });

  function showTooltip(word: string, rect: DOMRect, options: { autoHide?: boolean } = {}) {
    const detail = wordDetails[word.toLowerCase()];
    if (!detail || !tooltip) return;
    cleanup();
    activeTooltipWord = word;

    if (detail.p && ipa && phonetic) {
      ipa.textContent = `/${detail.p}/`;
      phonetic.style.display = "flex";
    } else if (phonetic) {
      phonetic.style.display = "none";
    }

    if (body) body.textContent = detail.t.replace(/\\n/g, "\n");

    if (examples && detail.e?.length) {
      examples.innerHTML = "";
      for (const ex of detail.e) {
        const exDiv = document.createElement("div");
        exDiv.className = "example";
        const enDiv = document.createElement("div");
        enDiv.className = "en";
        const segments = ex.en.split(/\{([^}]+)\}/g);
        segments.forEach((seg, i) => {
          if (i % 2 === 0) {
            enDiv.appendChild(document.createTextNode(seg));
          } else {
            const targetSpan = document.createElement("span");
            targetSpan.className = "target";
            targetSpan.textContent = seg;
            enDiv.appendChild(targetSpan);
          }
        });
        exDiv.appendChild(enDiv);
        const zhDiv = document.createElement("div");
        zhDiv.className = "zh";
        zhDiv.textContent = ex.zh;
        exDiv.appendChild(zhDiv);
        examples.appendChild(exDiv);
      }
      examples.style.display = "block";
    } else if (examples) {
      examples.style.display = "none";
    }

    const GAP = 8;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    tooltip.style.visibility = "hidden";
    tooltip.classList.remove("hidden");
    const tipRect = tooltip.getBoundingClientRect();
    let top = rect.bottom + GAP;
    let left = rect.left + (rect.width - tipRect.width) / 2;
    if (top + tipRect.height > vh - GAP) top = rect.top - tipRect.height - GAP;
    left = Math.max(GAP, Math.min(left, vw - tipRect.width - GAP));
    tooltip.style.top = `${top}px`;
    tooltip.style.left = `${left}px`;
    tooltip.style.visibility = "";
    tooltip.classList.add("show");
    if (options.autoHide !== false) {
      activeAutoHideTimer = setTimeout(cleanup, 30_000);
    }
  }

  let activeAutoHideTimer: ReturnType<typeof setTimeout> | null = null;

  function cleanup() {
    if (activeAutoHideTimer) {
      clearTimeout(activeAutoHideTimer);
      activeAutoHideTimer = null;
    }
    if (tooltip) {
      tooltip.classList.remove("show");
      tooltip.classList.add("hidden");
    }
    activeTooltipWord = null;
  }

  function bindAnnotationClicks() {
    const HOVER_SHOW_DELAY = 150;
    const HOVER_HIDE_DELAY = 120;
    let showTimer: ReturnType<typeof setTimeout> | null = null;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let isPinned = false;

    const clearShow = () => {
      if (showTimer !== null) {
        clearTimeout(showTimer);
        showTimer = null;
      }
    };
    const clearHide = () => {
      if (hideTimer !== null) {
        clearTimeout(hideTimer);
        hideTimer = null;
      }
    };
    const scheduleHide = () => {
      clearHide();
      hideTimer = setTimeout(() => {
        hideTimer = null;
        if (isPinned) return;
        cleanup();
      }, HOVER_HIDE_DELAY);
    };

    document.querySelectorAll("[data-readto]").forEach((el) => {
      const word = el.getAttribute("data-word") || "";
      el.addEventListener("pointerenter", () => {
        clearShow();
        clearHide();
        showTimer = setTimeout(() => {
          showTimer = null;
          showTooltip(word, el.getBoundingClientRect());
        }, HOVER_SHOW_DELAY);
      });
      el.addEventListener("pointerleave", () => {
        clearShow();
        if (!isPinned) scheduleHide();
      });
      el.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (isPinned && activeTooltipWord === word.toLowerCase()) {
          isPinned = false;
          scheduleHide();
        } else {
          isPinned = true;
          clearHide();
          clearShow();
          showTooltip(word, el.getBoundingClientRect());
        }
      });
    });

    tooltip?.addEventListener("pointerenter", () => {
      clearHide();
      clearShow();
    });
    tooltip?.addEventListener("pointerleave", () => {
      if (!isPinned) scheduleHide();
    });
    document.addEventListener("mousedown", (e) => {
      const target = e.target as Element;
      if (target.closest("[data-readto]")) return;
      if (tooltip?.contains(target)) return;
      isPinned = false;
      cleanup();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        isPinned = false;
        cleanup();
      }
    });
    window.addEventListener(
      "scroll",
      () => {
        isPinned = false;
        cleanup();
      },
      { passive: true },
    );
  }
  bindAnnotationClicks();

  // Level Slider
  const slider = document.getElementById("level-slider");
  const knob = document.getElementById("knob");
  const trackFill = document.getElementById("track-fill");
  const levelDesc = document.getElementById("level-desc");
  const demoContent = document.getElementById("demo-content");
  const sliderLabels = document.querySelectorAll(".slider-label");

  const levelDescs = [
    "只标最基础的词。",
    "标高考以下的词。",
    "只标大学四六级以上的词。",
    "标雅思托福以上的词。",
    "只标最生僻的词。",
  ];
  let currentLevel = 2;

  function getWordsForLevel(userLevelIndex: number): string[] {
    const userLevel = userLevelThresholds[userLevelIndex] || "B1";
    const threshold = LEVEL_ORDER[userLevel];
    return Object.entries(wordLevels)
      .filter(([_, wordLevel]) => LEVEL_ORDER[wordLevel] > threshold)
      .map(([word]) => word);
  }

  function ensureReadableDemoSpacing(root: HTMLElement) {
    root.querySelectorAll("[data-readto]").forEach((element) => {
      const next = element.nextSibling;
      if (!next) return;

      if (next.nodeType === Node.TEXT_NODE) {
        const text = next.textContent ?? "";
        if (text.length === 0 || /^\s/.test(text) || !/^[A-Za-z0-9]/.test(text)) return;
      } else if (
        next.nodeType !== Node.ELEMENT_NODE ||
        !(next as Element).matches("[data-readto]")
      ) {
        return;
      }

      element.after(document.createTextNode(" "));
    });
  }

  function updateAnnotations(level: number) {
    if (!demoContent) return;
    const showWords = getWordsForLevel(level);
    demoContent.querySelectorAll("[data-readto]").forEach((el) => {
      const word = el.getAttribute("data-word");
      if (word && showWords.includes(word)) {
        el.style.display = "";
        const rt = el.querySelector(".rt");
        if (rt) rt.style.display = "";
      } else if (word) {
        const rt = el.querySelector(".rt");
        if (rt) rt.style.display = "none";
      }
    });
  }

  function findDefaultTooltipTarget(): HTMLElement | null {
    if (!demoContent) return null;
    const preferredWords = ["overhaul", "profligate", "ameliorate", "sweeping", "president"];
    const candidates = preferredWords
      .map((word) => demoContent.querySelector<HTMLElement>(`[data-word="${word}"]`))
      .filter((el): el is HTMLElement => Boolean(el));
    candidates.push(...Array.from(demoContent.querySelectorAll<HTMLElement>("[data-readto]")));
    return (
      candidates.find((el) => {
        const rt = el.querySelector<HTMLElement>(".rt");
        return rt && window.getComputedStyle(rt).display !== "none";
      }) || null
    );
  }

  function showDefaultTooltip() {
    const target = findDefaultTooltipTarget();
    if (!target) return;
    const word = target.getAttribute("data-word");
    if (!word) return;
    showTooltip(word, target.getBoundingClientRect(), { autoHide: false });
  }

  function getPercent(level: number): number {
    return (level / 4) * 100;
  }

  function updateSlider(level: number, save = true) {
    currentLevel = level;
    const percent = getPercent(level);
    if (knob) knob.style.left = `${percent}%`;
    if (trackFill) trackFill.style.width = `${percent}%`;
    sliderLabels.forEach((label, i) => {
      if (i === level) {
        label.classList.add("active", "text-readto-ink", "font-medium");
        label.classList.remove("text-readto-muted-2");
      } else {
        label.classList.remove("active", "text-readto-ink", "font-medium");
        label.classList.add("text-readto-muted-2");
      }
    });
    if (levelDesc) levelDesc.textContent = levelDescs[level];
    if (slider) {
      slider.setAttribute("aria-valuenow", String(level + 1));
      slider.setAttribute(
        "aria-valuetext",
        ["入门", "基础", "进阶", "熟练", "精通"][level],
      );
    }
    updateAnnotations(level);
    showDefaultTooltip();
    if (save)
      try {
        localStorage.setItem("readto-level", String(level));
      } catch {}
  }

  function percentToLevel(percent: number): number {
    return Math.max(0, Math.min(4, Math.round(percent / 25)));
  }

  function pointerToLevel(clientX: number): number {
    if (!slider) return currentLevel;
    const rect = slider.getBoundingClientRect();
    const percent = ((clientX - rect.left) / Math.max(1, rect.width)) * 100;
    return percentToLevel(Math.max(0, Math.min(100, percent)));
  }

  let isDragging = false;
  slider?.addEventListener("mousedown", (e) => {
    isDragging = true;
    updateSlider(pointerToLevel(e.clientX));
    e.preventDefault();
  });
  document.addEventListener("mousemove", (e) => {
    if (isDragging) updateSlider(pointerToLevel(e.clientX));
  });
  document.addEventListener("mouseup", () => {
    isDragging = false;
  });
  slider?.addEventListener(
    "touchstart",
    (e) => {
      isDragging = true;
      updateSlider(pointerToLevel(e.touches[0].clientX));
      e.preventDefault();
    },
    { passive: false },
  );
  document.addEventListener(
    "touchmove",
    (e) => {
      if (isDragging) updateSlider(pointerToLevel(e.touches[0].clientX));
    },
    { passive: true },
  );
  document.addEventListener("touchend", () => {
    isDragging = false;
  });
  slider?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight" || e.key === "ArrowUp") {
      updateSlider(Math.min(4, currentLevel + 1));
      e.preventDefault();
    } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
      updateSlider(Math.max(0, currentLevel - 1));
      e.preventDefault();
    }
  });
  sliderLabels.forEach((label, i) => {
    label.addEventListener("click", () => updateSlider(i));
  });

  let savedLevel = 2;
  try {
    const stored = localStorage.getItem("readto-level");
    if (stored !== null) {
      const parsed = parseInt(stored, 10);
      if (parsed >= 0 && parsed <= 4) savedLevel = parsed;
    }
  } catch {}
  if (demoContent) ensureReadableDemoSpacing(demoContent);
  updateSlider(savedLevel, false);
</script>
