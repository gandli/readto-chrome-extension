---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const base = import.meta.env.BASE_URL;
---

<Layout>
  <SiteHeader current="home" />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-readto-rule">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(178,70,42,0.09),transparent_34%),linear-gradient(180deg,rgba(251,249,244,0.64),rgba(245,242,235,0))]"></div>
      <div class="relative mx-auto grid max-w-content gap-12 px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
        <div class="max-w-[640px]">
          <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-readto-rule bg-readto-card px-3 py-1.5 text-[12px] text-readto-muted shadow-[0_1px_0_rgba(20,18,16,0.03)]">
            <span class="h-1.5 w-1.5 rounded-full bg-readto-accent"></span>
            <span data-i18n="home.badge">Chrome 扩展 · 为真实英文网页加中文小注</span>
          </div>
          <h1 class="font-serif text-[48px] font-normal leading-[0.98] tracking-[-0.035em] text-readto-fg sm:text-[74px] lg:text-[92px]" data-i18n-html="home.heroTitle">读英文，<br />不用频繁查词。</h1>
          <p class="mt-7 max-w-[560px] text-[17px] leading-[1.8] text-readto-fg-2 sm:text-[19px]">
            <span data-i18n="home.heroBody">readto 会根据你的英语水平，在英文网页的生词上方悄悄标好中文释义。中文小注像书页边注一样出现，不划词、不跳窗、不中断阅读。</span>
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="https://chromewebstore.google.com/detail/readto/icijjidbmcgedpiljpknpjomjjijacjp"
              class="inline-flex items-center justify-center rounded-full bg-readto-fg px-6 py-3 text-[15px] font-medium text-readto-bg transition hover:-translate-y-0.5 hover:bg-readto-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-i18n="home.ctaPrimary">添加到 Chrome</span>
            </a>
            <a href="#experience" class="inline-flex items-center justify-center rounded-full border border-readto-rule bg-readto-card px-6 py-3 text-[15px] font-medium text-readto-fg transition hover:border-readto-fg">
              <span data-i18n="home.ctaSecondary">先看一段真实阅读</span>
            </a>
          </div>
          <div class="mt-8 grid max-w-[560px] grid-cols-3 border-y border-readto-rule text-[12px] text-readto-muted">
            <div class="py-4 pr-4">
              <div class="font-serif text-[22px] text-readto-fg">0</div>
              <div data-i18n="home.statZero">划词步骤</div>
            </div>
            <div class="border-l border-readto-rule px-4 py-4">
              <div class="font-serif text-[22px] text-readto-fg">5</div>
              <div data-i18n="home.statLevel">档英语水平</div>
            </div>
            <div class="border-l border-readto-rule py-4 pl-4">
              <div class="font-serif text-[22px] text-readto-fg" data-i18n="home.statAnyValue">任意</div>
              <div data-i18n="home.statAny">英文网页</div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -left-8 -top-8 hidden h-28 w-28 rounded-full border border-readto-rule lg:block"></div>
          <div class="relative rounded-[14px] border border-readto-rule bg-readto-card p-3 shadow-[0_28px_80px_rgba(36,29,22,0.12)]">
            <div class="rounded-[12px] border border-readto-rule-2 bg-readto-card p-4 sm:p-6">
              <div class="mb-5 flex items-center justify-between border-b border-readto-rule pb-4">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#e07a5f]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#e9c46a]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#81b29a]"></span>
                </div>
                <div class="rounded-full border border-readto-rule bg-readto-bg px-3 py-1 text-[11px] text-readto-muted">readto enabled</div>
              </div>
              <article class="font-serif text-[19px] leading-[2.25] text-readto-fg sm:text-[22px]">
                <p class="mb-5 text-[12px] uppercase tracking-[0.18em] text-readto-muted">The Atlantic · Culture</p>
                <h2 class="mb-5 text-[30px] leading-tight tracking-[-0.02em] sm:text-[36px]">A city learns to listen again</h2>
                <p>
                  The mayor announced <span data-readto data-word="sweeping">sweeping<span class="rt">全面的</span></span> reforms after a week of <span data-readto data-word="tense">tense<span class="rt">紧张的</span></span> negotiations, but residents remained <span data-readto data-word="skeptical">skeptical<span class="rt">怀疑的</span></span> of another <span data-readto data-word="perfunctory">perfunctory<span class="rt">敷衍的</span></span> promise.
                </p>
              </article>
            </div>
          </div>
          <div class="absolute -bottom-5 left-8 rounded-[14px] border border-readto-rule bg-readto-bg px-4 py-3 text-[12px] text-readto-muted shadow-[0_12px_32px_rgba(36,29,22,0.1)]">
            <span data-i18n="home.heroNote">中文释义停在词上方，阅读继续向前。</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive reading experience -->
    <section id="experience" class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.45fr_0.55fr] lg:items-start">
        <div class="lg:sticky lg:top-24">
          <div class="mb-5 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-readto-muted">
            <span class="h-px w-8 bg-readto-accent"></span>
            <span data-i18n="home.demoEyebrow">Reading demo</span>
          </div>
          <h2 class="font-serif text-[36px] font-normal leading-[1.06] tracking-[-0.035em] sm:text-[54px]">
            <span data-i18n="home.demoTitle">你的水平越高，页面越安静。</span>
          </h2>
          <p class="mt-5 max-w-[460px] text-[16px] leading-[1.8] text-readto-fg-2">
            <span data-i18n="home.demoBody">调整英语水平，readto 会只标出超过当前水平的词。你已经掌握的词会回到正文里，避免把整页变成词典。</span>
          </p>

          <div class="mt-8 rounded-[14px] border border-readto-rule bg-readto-card p-5">
            <div class="mb-4 flex items-center justify-between text-[13px]">
              <span class="font-medium text-readto-fg"><span data-i18n="home.levelLabel">我的英语水平</span></span>
              <span id="level-desc" class="text-readto-muted">只标大学四六级以上的词。</span>
            </div>
            <div
              id="level-slider"
              class="relative h-8 cursor-pointer touch-none rounded-full"
              role="slider"
              tabindex="0"
              aria-label="选择英语水平"
              aria-valuemin="1"
              aria-valuemax="5"
              aria-valuenow="3"
              aria-valuetext="进阶"
            >
              <div class="absolute left-[10%] right-[10%] top-1/2 h-px -translate-y-1/2 bg-readto-rule"></div>
              <div id="track-fill" class="absolute left-[10%] top-1/2 h-px -translate-y-1/2 bg-readto-fg transition-[width] duration-300" style="width:40%"></div>
              <div id="knob" class="absolute top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-readto-bg bg-readto-fg shadow-[0_0_0_1px_rgba(20,18,16,0.12),0_8px_18px_rgba(20,18,16,0.16)] transition-[left] duration-300" style="left:50%"></div>
              <div class="absolute left-[10%] top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-readto-fg"></div>
              <div class="absolute left-[30%] top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-readto-rule"></div>
              <div class="absolute left-[50%] top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-readto-rule"></div>
              <div class="absolute left-[70%] top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-readto-rule"></div>
              <div class="absolute left-[90%] top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-readto-rule"></div>
            </div>
            <div class="mt-3 grid grid-cols-5 text-center text-[11px] text-readto-muted-2">
              <button type="button" class="slider-label" data-i18n="home.level.beginner">入门</button>
              <button type="button" class="slider-label" data-i18n="home.level.basic">基础</button>
              <button type="button" class="slider-label active" data-i18n="home.level.intermediate">进阶</button>
              <button type="button" class="slider-label" data-i18n="home.level.advanced">熟练</button>
              <button type="button" class="slider-label" data-i18n="home.level.fluent">精通</button>
            </div>
          </div>
        </div>

        <div class="rounded-[14px] border border-readto-rule bg-readto-card p-3 shadow-[0_24px_70px_rgba(36,29,22,0.1)]">
          <div class="rounded-[12px] border border-readto-rule-2 bg-readto-card p-5 sm:p-8">
            <div class="mb-8 flex items-center justify-between border-b border-readto-rule pb-4">
              <div>
                <p class="text-[11px] uppercase tracking-[0.18em] text-readto-muted"><span data-i18n="home.previewLabel">Live article preview</span></p>
                <p class="mt-1 font-serif text-[20px] text-readto-fg"><span data-i18n="home.previewTitle">The quieter dictionary</span></p>
              </div>
              <span class="rounded-full bg-readto-bg px-3 py-1 text-[11px] text-readto-muted"><span data-i18n="home.previewHint">hover words</span></span>
            </div>
            <div id="demo-content" class="font-serif text-[18px] leading-[2.25] text-readto-fg sm:text-[21px]">
              <p>
                The president <span data-readto data-word="announced">announced<span class="rt">宣布</span></span> a <span data-readto data-word="sweeping">sweeping<span class="rt">全面的</span></span> set of <span data-readto data-word="reforms">reforms<span class="rt">改革</span></span> yesterday, <span data-readto data-word="marking">marking<span class="rt">标志着</span></span> the most <span data-readto data-word="ambitious">ambitious<span class="rt">雄心勃勃的</span></span> effort to <span data-readto data-word="overhaul">overhaul<span class="rt">彻底改革</span></span> the tax system in a generation.
              </p>
              <p class="mt-6">
                Yet many <span data-readto data-word="analysts">analysts<span class="rt">分析人士</span></span> warned that the proposal could prove <span data-readto data-word="contentious">contentious<span class="rt">有争议的</span></span>, especially among <span data-readto data-word="skeptical">skeptical<span class="rt">怀疑的</span></span> voters who view previous <span data-readto data-word="concessions">concessions<span class="rt">让步</span></span> as merely <span data-readto data-word="perfunctory">perfunctory<span class="rt">敷衍的</span></span>.
              </p>
              <p class="mt-6">
                The latest <span data-readto data-word="polls">polls<span class="rt">民意调查</span></span> <span data-readto data-word="indicate">indicate<span class="rt">表明</span></span> that negotiations remain at a <span data-readto data-word="fragile">fragile<span class="rt">脆弱的</span></span> <span data-readto data-word="impasse">impasse<span class="rt">僵局</span></span>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- <span data-i18n="home.howEyebrow">How it works</span> -->
    <section id="how" class="border-t border-readto-rule py-16 sm:py-20">
      <div class="mx-auto max-w-content px-4 sm:px-6">
        <div class="mb-10 grid gap-6 md:grid-cols-[0.38fr_0.62fr] md:items-end">
          <div class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-readto-muted">
            <span class="h-px w-8 bg-readto-accent"></span>
            <span data-i18n="home.howEyebrow">How it works</span>
          </div>
          <h2 class="font-serif text-[34px] font-normal leading-[1.08] tracking-[-0.035em] sm:text-[50px]" data-i18n-html="home.howTitle">它不是另一个词典入口，<br />而是一层安静的阅读注释。</h2>
        </div>
        <div class="grid border-t border-readto-rule md:grid-cols-3">
          <div class="border-b border-readto-rule py-8 md:border-b-0 md:border-r md:pr-8">
            <div class="font-serif text-[15px] text-readto-accent">No. 01</div>
            <h3 class="mt-4 font-serif text-[23px] font-normal tracking-[-0.02em]"><span data-i18n="home.how1Title">先判断你的水平</span></h3>
            <p class="mt-3 text-[14px] leading-[1.8] text-readto-fg-2"><span data-i18n="home.how1Body">选择入门、基础、进阶、熟练或精通，readto 会把这个水平当作“已掌握词汇”的边界。</span></p>
            <p class="mt-8 border-t border-dotted border-readto-rule pt-5 font-serif text-[17px] leading-9">He was <span data-readto data-word="ostensibly">ostensibly<span class="rt">表面上</span></span> in charge.</p>
          </div>
          <div class="border-b border-readto-rule py-8 md:border-b-0 md:border-r md:px-8">
            <div class="font-serif text-[15px] text-readto-accent">No. 02</div>
            <h3 class="mt-4 font-serif text-[23px] font-normal tracking-[-0.02em]"><span data-i18n="home.how2Title">只给超纲词加注</span></h3>
            <p class="mt-3 text-[14px] leading-[1.8] text-readto-fg-2"><span data-i18n="home.how2Body">常见词保持原样，真正可能打断理解的词，才在上方出现一条短中文释义。</span></p>
            <p class="mt-8 border-t border-dotted border-readto-rule pt-5 font-serif text-[17px] leading-9">The findings were <span data-readto data-word="ambiguous">ambiguous<span class="rt">模糊的</span></span>.</p>
          </div>
          <div class="py-8 md:pl-8">
            <div class="font-serif text-[15px] text-readto-accent">No. 03</div>
            <h3 class="mt-4 font-serif text-[23px] font-normal tracking-[-0.02em]"><span data-i18n="home.how3Title">留在原网页阅读</span></h3>
            <p class="mt-3 text-[14px] leading-[1.8] text-readto-fg-2"><span data-i18n="home.how3Body">新闻、博客、文档、论文都在原页面完成阅读，不跳到另一个学习工具里。</span></p>
            <div class="mt-8 flex flex-wrap gap-2 border-t border-dotted border-readto-rule pt-5">
              <span class="rounded-full border border-readto-rule bg-readto-bg px-3 py-1 text-[12px] text-readto-muted">news</span>
              <span class="rounded-full border border-readto-rule bg-readto-bg px-3 py-1 text-[12px] text-readto-muted">docs</span>
              <span class="rounded-full border border-readto-rule bg-readto-bg px-3 py-1 text-[12px] text-readto-muted">papers</span>
              <span class="rounded-full border border-readto-rule bg-readto-bg px-3 py-1 text-[12px] text-readto-muted">blogs</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Fit -->
    <section id="fit" class="border-t border-readto-rule bg-[linear-gradient(180deg,var(--color-readto-bg),var(--color-readto-rule-2))] py-16 sm:py-20">
      <div class="mx-auto grid max-w-content gap-10 px-4 sm:px-6 lg:grid-cols-[0.42fr_0.58fr] lg:items-start">
        <div>
          <div class="mb-5 text-[11px] font-semibold uppercase tracking-[0.16em] text-readto-muted"><span data-i18n="home.fitEyebrow">Who it is for</span></div>
          <blockquote class="font-serif text-[34px] font-normal leading-[1.12] tracking-[-0.035em] sm:text-[50px]">
            <span data-i18n="home.fitQuote">背单词的最好方式，是在真实阅读里反复遇到它。</span>
          </blockquote>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-[14px] border border-readto-rule bg-readto-card p-5">
            <h3 class="font-serif text-[22px] font-normal"><span data-i18n="home.fit1Title">读英文资讯</span></h3>
            <p class="mt-3 text-[14px] leading-[1.75] text-readto-fg-2"><span data-i18n="home.fit1Body">想直接看英文报道和长文，但不想每遇到一个词就离开页面。</span></p>
          </div>
          <div class="rounded-[14px] border border-readto-rule bg-readto-card p-5">
            <h3 class="font-serif text-[22px] font-normal"><span data-i18n="home.fit2Title">读技术文档</span></h3>
            <p class="mt-3 text-[14px] leading-[1.75] text-readto-fg-2"><span data-i18n="home.fit2Body">希望保持英文原文语境，同时降低专业表达带来的查词摩擦。</span></p>
          </div>
          <div class="rounded-[14px] border border-readto-rule bg-readto-card p-5">
            <h3 class="font-serif text-[22px] font-normal"><span data-i18n="home.fit3Title">读论文博客</span></h3>
            <p class="mt-3 text-[14px] leading-[1.75] text-readto-fg-2"><span data-i18n="home.fit3Body">不把阅读变成背单词任务，而是在内容里自然积累词汇。</span></p>
          </div>
          <div class="rounded-[14px] border border-readto-rule bg-readto-card p-5">
            <h3 class="font-serif text-[22px] font-normal"><span data-i18n="home.fit4Title">准备考试</span></h3>
            <p class="mt-3 text-[14px] leading-[1.75] text-readto-fg-2"><span data-i18n="home.fit4Body">通过真实语境反复遇到生词，比孤立记忆更容易留下印象。</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
      <div class="rounded-[14px] border border-readto-rule bg-readto-card p-8 sm:p-12 lg:flex lg:items-end lg:justify-between">
        <div>
          <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.16em] text-readto-muted"><span data-i18n="home.finalEyebrow">Start reading</span></p>
          <h2 class="max-w-[720px] font-serif text-[38px] font-normal leading-[1.06] tracking-[-0.035em] sm:text-[56px]" data-i18n="home.finalTitle">让下一篇英文网页，自己长出中文小注。</h2>
        </div>
        <a
          href="https://chromewebstore.google.com/detail/readto/icijjidbmcgedpiljpknpjomjjijacjp"
          class="mt-8 inline-flex shrink-0 items-center justify-center rounded-full bg-readto-fg px-6 py-3 text-[15px] font-medium text-readto-bg transition hover:-translate-y-0.5 hover:bg-readto-accent lg:mt-0"
          target="_blank"
          rel="noopener noreferrer"
        >
          添加到 Chrome
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <!-- Translation Tooltip -->
  <div id="tooltip" class="tooltip hidden">
    <div class="phonetic">
      <button class="speaker" type="button" aria-label="Play pronunciation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
      </button>
      <span class="ipa"></span>
    </div>
    <div class="body"></div>
    <div class="examples"></div>
  </div>
</Layout>
<script>
  // 从扩展项目 level-data-full.json + translations-detail 导出
  const LEVEL_ORDER: Record<string, number> = {
    A1: 1,
    A2: 2,
    B1: 3,
    B2: 4,
    C1: 5,
    C2: 6,
  };
  const userLevelThresholds = ["A1", "A2", "B1", "B2", "C1"];
  const wordLevels: Record<string, string> = {
    the: "A1",
    president: "A2",
    announced: "A2",
    sweeping: "B1",
    reforms: "B1",
    nation: "A1",
    tax: "A2",
    system: "A1",
    yesterday: "A1",
    marking: "B1",
    most: "A1",
    significant: "B1",
    overhaul: "B2",
    decade: "A2",
    critics: "B1",
    denounce: "B2",
    changes: "A1",
    disproportionately: "B2",
    benefiting: "A2",
    wealthy: "A2",
    citizens: "A2",
    accusing: "B1",
    administration: "B1",
    profligate: "C2",
    giveaways: "B1",
    and: "A1",
    austerity: "B2",
    toward: "A2",
    middle: "A1",
    class: "A1",
    families: "A1",
    already: "A1",
    burdened: "B1",
    rising: "A2",
    costs: "A1",
    proponents: "B2",
    counter: "A2",
    that: "A1",
    lower: "A2",
    taxes: "A2",
    will: "A1",
    stimulate: "B1",
    investment: "A2",
    ameliorate: "C1",
    bill: "A1",
    faces: "A1",
    difficult: "A1",
    path: "A1",
    through: "A1",
    fractious: "C2",
    polarized: "C1",
    legislature: "B1",
    where: "A1",
    opposition: "B1",
    lawmakers: "B2",
    have: "A1",
    vowed: "B2",
    obstruct: "B2",
    its: "A1",
    passage: "A2",
    with: "A1",
    vituperative: "C2",
    floor: "A1",
